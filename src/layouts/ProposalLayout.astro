---
/**
 * Layout for the Pottsville-styled proposal pages under /proposals/.
 *
 * Deliberately NOT BaseLayout: this page has to look like a Pottsville page, so
 * it takes the default (Pottsville) theme — no `data-theme="healthhub"` — and
 * carries its own Pottsville-flavoured header and footer rather than the Health
 * Hub ones. The two themes therefore never mix.
 *
 * Nothing here touches the Pottsville repo or site. It is a mockup hosted on the
 * Health Hub domain, so it is kept out of the index three ways: noindex,nofollow
 * here, `Disallow: /proposals/` in robots.txt, and excluded from the sitemap in
 * astro.config.mjs. It also emits no structured data.
 */
import '@styles/global.css';

interface Props {
  title: string;
  /** What this is a proposal for, shown in the banner. */
  proposalFor: string;
}
const { title, proposalFor } = Astro.props;

/** Mirrors the live Pottsville menu so the mockup sits in a familiar frame. */
const nav = [
  { label: 'Approach', href: 'https://pottsvilleacupuncture.com.au/approach/' },
  { label: 'Conditions', href: 'https://pottsvilleacupuncture.com.au/conditions/' },
  { label: 'Services + Fees', href: 'https://pottsvilleacupuncture.com.au/services/' },
  { label: 'Wellness Hub', href: '/proposals/hub', current: true },
  { label: 'About', href: 'https://pottsvilleacupuncture.com.au/about/' },
  { label: 'Contact', href: 'https://pottsvilleacupuncture.com.au/contact/' },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {/* A proposal hosted on someone else's domain must never be indexed. */}
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preload" href="/fonts/reborn.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noah-bold.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="proposal">
    <div class="pbar">
      <div class="container pbar-inner">
        <span class="pbar-tag">Design proposal</span>
        <p>
          Concept for <strong>{proposalFor}</strong> — not a live page. Hosted on the Health Hub
          domain for review, excluded from search engines. Pottsville's own site is untouched.
        </p>
      </div>
    </div>

    <header class="phead">
      <div class="container phead-inner">
        <a href="https://pottsvilleacupuncture.com.au/" class="pwordmark">
          <span class="pwordmark-1">Pottsville</span>
          <span class="pwordmark-2">Acupuncture</span>
        </a>
        <nav aria-label="Pottsville Acupuncture">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a href="https://pottsvilleacupuncture.com.au/book/" class="btn btn-primary phead-cta">
          Book an appointment
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pfoot">
      <div class="container pfoot-grid">
        <div>
          <a href="https://pottsvilleacupuncture.com.au/" class="pwordmark pwordmark-light">
            <span class="pwordmark-1">Pottsville</span>
            <span class="pwordmark-2">Acupuncture</span>
          </a>
          <p class="pfoot-blurb">
            Thirty-five years of integrative TCM clinical practice, located on the Tweed Coast
            — at 87–89 Tweed Coast Road, Hastings Point.
          </p>
        </div>
        <div>
          <h2 class="pfoot-h">Pottsville</h2>
          <ul class="pfoot-nav">
            <li><a href="https://pottsvilleacupuncture.com.au/approach/">Our approach</a></li>
            <li><a href="https://pottsvilleacupuncture.com.au/conditions/">Conditions</a></li>
            <li><a href="https://pottsvilleacupuncture.com.au/services/">Services + Fees</a></li>
            <li><a href="https://pottsvilleacupuncture.com.au/book/">Book</a></li>
          </ul>
        </div>
        <div>
          <h2 class="pfoot-h">Family</h2>
          <ul class="pfoot-nav">
            <li><a href="/proposals/hub">Hastings Wellness Hub</a></li>
            <li><a href="https://www.healthhubtweedcoast.com.au/">Health Hub Tweed Coast</a></li>
          </ul>
        </div>
        <div>
          <h2 class="pfoot-h">Practical</h2>
          <ul class="pfoot-nav">
            <li><a href="tel:+61420437156">0420 437 156</a></li>
            <li>
              <a href="mailto:health@pottsvilleacupuncture.com.au">health@pottsvilleacupuncture.com.au</a>
            </li>
            <li>Mon–Fri · 9am–7:30pm</li>
            <li>Sat · 9am–2pm</li>
          </ul>
        </div>
      </div>
      <div class="container pfoot-fine">
        <p>
          <strong>AHPRA &amp; TGA disclaimer.</strong> Pottsville Acupuncture is registered with
          AHPRA and the Chinese Medicine Board of Australia. We do not diagnose, treat, cure or
          prevent any specific medical condition in language outside what is permitted under AHPRA
          and TGA guidelines. Treatments described on this site are intended to support the body's
          own capacity to heal, not to replace medical advice from your GP or specialist. Always
          consult your treating doctor about any condition that concerns you.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* The proposal deliberately runs on the default (Pottsville) token set, so
     nothing here redefines brand colour — only the page-specific chrome. */
  body.proposal { background: var(--p-paper); }

  /* ---- Proposal banner ---- */
  .pbar {
    background: #2b2b2b;
    color: #fff;
    padding: 10px 0;
    font-size: 13px;
  }
  .pbar-inner { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .pbar-tag {
    flex-shrink: 0;
    background: var(--p-hero);
    color: #083434;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 3px;
  }
  .pbar p { margin: 0; max-width: none; opacity: 0.88; }
  .pbar strong { color: #fff; }

  /* ---- Pottsville-style header ----
     A typographic wordmark, not their logo file: the mockup lives in this repo
     and must not pull assets from their site. Their real logo drops in here. */
  .phead {
    background: #fff;
    border-bottom: 1px solid var(--p-grey-100);
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .phead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-height: 78px;
  }
  .pwordmark { display: block; line-height: 1; text-decoration: none; }
  .pwordmark-1 {
    display: block;
    font-family: var(--font-heading);
    font-size: 22px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--p-deep);
  }
  .pwordmark-2 {
    display: block;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--p-hero);
    margin-top: 4px;
  }
  .pwordmark-light .pwordmark-1 { color: #fff; }
  .pwordmark-light .pwordmark-2 { color: var(--p-hero); }

  .phead nav ul {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .phead nav a {
    font-size: 14px;
    color: var(--p-grey-700);
    text-decoration: none;
    padding-block: 6px;
  }
  .phead nav a:hover { color: var(--p-deep); }
  .phead nav a[aria-current='page'] {
    color: var(--p-deep);
    box-shadow: inset 0 -2px 0 var(--p-hero);
  }
  .phead-cta { flex-shrink: 0; }

  @media (max-width: 1080px) {
    .phead nav { display: none; }
  }
  /* Below this the wordmark and the booking button no longer fit on one line —
     without wrapping, the button pushed the page 29px wider than the viewport. */
  @media (max-width: 620px) {
    .phead-inner {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 14px;
      min-height: 0;
      padding-block: 16px;
    }
    .phead-cta { width: 100%; }
  }

  /* ---- Footer ---- */
  .pfoot {
    background: var(--p-deep);
    color: #fff;
    padding-block: 72px 28px;
    margin-top: 0;
  }
  .pfoot-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 40px;
  }
  .pfoot-blurb { margin-top: 18px; font-size: 14px; opacity: 0.82; max-width: 34ch; }
  .pfoot-h {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.72;
    margin: 0 0 16px;
    color: #fff;
  }
  .pfoot-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    opacity: 0.9;
  }
  .pfoot-nav a { color: #fff; text-decoration: none; }
  .pfoot-nav a:hover { text-decoration: underline; }
  .pfoot-fine {
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .pfoot-fine p { font-size: 11.5px; line-height: 1.6; opacity: 0.66; max-width: none; }

  @media (max-width: 880px) {
    .pfoot-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 540px) {
    .pfoot-grid { grid-template-columns: 1fr; }
  }
</style>
