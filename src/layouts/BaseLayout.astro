---
/**
 * BaseLayout — the shared shell for every Health Hub page.
 *
 * Applies the Health Hub sibling theme (data-theme="healthhub"), a base
 * meta/OG scaffold (the full SEO layer — JSON-LD, richer OG — lands in
 * Phase 5), the shared header and footer, and the Google Fonts baseline.
 *
 * The Pottsville-styled /proposals/hub page (Prompt 2) uses its OWN layout,
 * not this one, so the two themes stay isolated.
 */
import { site } from '@data/site';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Path used to build the canonical URL, e.g. "/services". */
  path?: string;
  /** Absolute or site-relative OG image. */
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  ogImage = '/assets/og-default.jpg',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · Wellness Studio, Hastings Point`;
/**
 * Canonicals always carry a trailing slash, matching both the sitemap and the
 * URLs the live WordPress site serves — so a page never advertises a canonical
 * that differs from the address it is actually indexed under.
 */
const canonicalPath = path === '/' ? '/' : `${path.replace(/\/+$/, '')}/`;
const canonical = new URL(canonicalPath, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
---

<!doctype html>
<html lang="en-AU" data-theme="healthhub">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_AU" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Brand fonts — self-hosted licensed Pottsville family (see fonts.css) */}
    <link rel="preload" href="/fonts/reborn.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noah-bold.woff2" as="font" type="font/woff2" crossorigin />
    {/* Interim fallback for Noah's not-yet-supplied upright weights (400/500/600).
        Remove once Noah Regular/Medium/SemiBold are self-hosted. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
