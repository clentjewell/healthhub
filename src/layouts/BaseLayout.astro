---
/**
 * BaseLayout — the shared shell for every Health Hub page.
 *
 * Applies the Health Hub sibling theme (data-theme="healthhub"), a base
 * meta/OG scaffold (the full SEO layer — JSON-LD, richer OG — lands in
 * Phase 5), the shared header and footer, and the Google Fonts baseline.
 */
import { site } from '@data/site';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getSettings } from '../lib/content';
import { businessNode, websiteNode } from '../lib/schema';
import { pageTitle as buildTitle } from '../lib/seo';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Path used to build the canonical URL, e.g. "/services". */
  path?: string;
  /** Absolute or site-relative OG image. */
  ogImage?: string;
  noindex?: boolean;
  /** og:type — "article" for a profile or event page, else "website". */
  ogType?: string;
  /**
   * The complete browser title, used verbatim. The five CMS-edited pages set
   * this so an editor controls the whole string; detail pages pass `title`
   * instead and get the brand appended.
   */
  fullTitle?: string;
  /**
   * Page-specific JSON-LD nodes. The business and website nodes are always
   * included, so pages only pass what is unique to them and reference the
   * business by @id rather than repeating it.
   */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  ogImage = '/assets/og-default.jpg',
  noindex = false,
  ogType = 'website',
  fullTitle,
  schema = [],
} = Astro.props;

const cfg = await getSettings();
/**
 * One `@graph` per page. A noindex page (the CMS, the Pottsville proposal) gets
 * no structured data at all — there is nothing to tell a search engine about a
 * page it is being asked not to index.
 */
const graph = noindex
  ? null
  : { '@context': 'https://schema.org', '@graph': [businessNode(cfg), websiteNode(), ...schema] };

/**
 * JSON-LD for embedding in a <script>. JSON.stringify does not escape "<", so a
 * content field containing "</script>" would break out of the tag. Escaping the
 * three HTML-significant characters (still valid JSON — they only ever appear
 * inside string values) closes that off. U+2028/U+2029 are escaped too, since
 * they are literal newlines in a JS/JSON string context.
 */
const jsonLd = graph
  ? JSON.stringify(graph)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029')
  : null;

const pageTitle = fullTitle ?? buildTitle(title);
/**
 * Canonicals always carry a trailing slash, matching both the sitemap and the
 * URLs the live WordPress site serves — so a page never advertises a canonical
 * that differs from the address it is actually indexed under.
 */
const canonicalPath = path === '/' ? '/' : `${path.replace(/\/+$/, '')}/`;
const canonical = new URL(canonicalPath, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
---

<!doctype html>
<html lang="en-AU" data-theme="healthhub">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_AU" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    {/* Brand fonts — self-hosted licensed Pottsville family, no external
        request. See fonts.css for the upright-weight situation. */}
    <link rel="preload" href="/fonts/reborn.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/noah-bold.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
