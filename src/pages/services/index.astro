---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CtaBand from '@components/CtaBand.astro';

const services = (await getCollection('services'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Services"
  description="Acupuncture, allied health and movement services at Health Hub Tweed Coast, Hastings Point."
>
  <PageHeader
    eyebrow="What we offer"
    title="Services"
    lede="Treatments and classes to support your wellbeing on the Tweed Coast."
  />

  <section class="section">
    <div class="container">
      <div class="grid-services">
        {
          services.map((s) => (
            <ServiceCard
              title={s.data.shortTitle ?? s.data.title}
              summary={s.data.summary}
              href={`/services/${s.id}`}
              icon={s.data.icon}
              placeholder={s.data.placeholder}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .grid-services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) { .grid-services { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid-services { grid-template-columns: 1fr; } }
</style>
