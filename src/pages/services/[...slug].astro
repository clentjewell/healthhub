---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import PlaceholderImage from '@components/PlaceholderImage.astro';
import CtaBand from '@components/CtaBand.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, image, provider, bookingUrl, bookingPhone, placeholder } = entry.data;

const practitioner = provider ? await getEntry('practitioners', provider) : undefined;
const telHref = bookingPhone ? `tel:${bookingPhone.replace(/\s/g, '')}` : undefined;
---

<BaseLayout title={title} description={summary} path={`/services/${entry.id}`}>
  <PageHeader eyebrow="Service" title={title} lede={summary} />

  <article class="section">
    <div class="container service-layout">
      <div class="service-content">
        {image && <img class="service-hero-img" src={image} alt={title} />}
        {placeholder && <p class="ph-note">Placeholder content — real copy migrated in Phase 3.</p>}
        <Content />

        <div class="service-actions">
          {bookingUrl && <a href={bookingUrl} class="btn btn-primary">Book online</a>}
          {telHref && <a href={telHref} class="btn btn-ghost">Call {bookingPhone}</a>}
          {!bookingUrl && !telHref && <a href="/booking" class="btn btn-primary">Make a booking</a>}
        </div>
      </div>

      <aside class="service-aside">
        {
          practitioner && (
            <a class="provider-card" href={`/practitioners/${practitioner.id}`}>
              <span class="provider-eyebrow">Offered by</span>
              <div class="provider-media">
                {practitioner.data.image ? (
                  <img src={practitioner.data.image} alt={`Portrait of ${practitioner.data.name}`} loading="lazy" />
                ) : (
                  <PlaceholderImage label="Portrait" ratio="4/5" icon="👤" />
                )}
              </div>
              <span class="provider-name">{practitioner.data.name}</span>
              <span class="provider-role">{practitioner.data.role}</span>
              <span class="provider-link">View profile →</span>
            </a>
          )
        }
      </aside>
    </div>
  </article>

  <CtaBand />
</BaseLayout>

<style>
  .service-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    align-items: start;
  }
  .service-hero-img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: 28px;
  }
  .service-content :global(p) { color: var(--color-text); }
  .service-actions { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
  .ph-note {
    font-size: 13px; color: var(--color-text-muted);
    border-left: 3px solid var(--color-accent); padding-left: 12px; font-style: italic;
  }
  .provider-card {
    position: sticky;
    top: 96px;
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 24px;
    color: var(--color-text);
  }
  .provider-card:hover { border-color: var(--color-accent); box-shadow: var(--shadow-md); }
  .provider-eyebrow {
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-accent); font-weight: 600;
  }
  .provider-media { border-radius: var(--radius-sm); overflow: hidden; margin: 14px 0; }
  .provider-media img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .provider-name { display: block; font-weight: 700; font-size: 1.1rem; }
  .provider-role { display: block; font-size: 13px; color: var(--color-text-muted); margin-bottom: 12px; }
  .provider-link { font-size: 13px; font-weight: 600; color: var(--color-brand); }
  @media (max-width: 860px) {
    .service-layout { grid-template-columns: 1fr; }
    .provider-card { position: static; max-width: 320px; }
  }
</style>
