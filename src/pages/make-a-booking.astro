---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { getPage } from '../lib/content';

const page = await getPage('booking');

const practitioners = (await getCollection('practitioners'))
  .filter((p) => p.data.active)
  .sort((a, b) => a.data.order - b.data.order);

// Resolve each practitioner's service label for display.
const rows = await Promise.all(
  practitioners.map(async (p) => {
    const svc = p.data.service ? await getEntry('services', p.data.service) : undefined;
    return {
      name: p.data.name,
      href: `/our-practitioner/${p.id}`,
      image: p.data.image,
      service: svc?.data.title ?? p.data.role,
      bookingUrl: p.data.bookingUrl,
      phone: p.data.phone,
    };
  }),
);
---

<BaseLayout fullTitle={page.metaTitle} description={page.metaDescription}>
  <PageHeader eyebrow={page.eyebrow} title={page.heading!} lede={page.lede} />

  <section class="section">
    <div class="container narrow-mid">
      <ul class="booking-list">
        {
          rows.map((r) => (
            <li class="booking-row">
              <div class="bk-info">
                {r.image && <img class="bk-avatar" src={r.image} alt={r.name} loading="lazy" width="56" height="56" />}
                <div>
                  <a class="bk-name" href={r.href}>{r.name}</a>
                  <span class="bk-service">{r.service}</span>
                </div>
              </div>
              <div class="bk-actions">
                {r.bookingUrl && <a href={r.bookingUrl} class="btn btn-primary bk-btn">Book online</a>}
                {r.phone && (
                  <a href={`tel:${r.phone.replace(/\s/g, '')}`} class="bk-phone">{r.phone}</a>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      {page.extraNote && <p class="bk-extra">{page.extraNote}</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .narrow-mid { max-width: 820px; margin-inline: auto; }
  .booking-list { list-style: none; margin: 0; padding: 0; }
  .booking-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .bk-info { display: flex; align-items: center; gap: 16px; }
  .bk-avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: top; flex-shrink: 0; }
  .bk-name { font-weight: 700; font-size: 1.05rem; display: block; }
  .bk-service { font-size: 13px; color: var(--color-text-muted); }
  .bk-actions { display: flex; align-items: center; gap: 16px; white-space: nowrap; }
  .bk-btn { padding: 8px 20px; font-size: 13px; }
  .bk-phone { font-size: 14px; font-weight: 600; color: var(--color-brand); }
  .bk-extra {
    margin-top: 32px;
    font-size: 14px;
    color: var(--color-text-muted);
    border-left: 3px solid var(--color-accent);
    padding-left: 12px;
  }
  @media (max-width: 560px) {
    .booking-row { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
