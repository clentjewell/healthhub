---
/**
 * /faq/ — one flat list of questions and answers.
 *
 * A dedicated page rather than a homepage block, for three reasons. Thirteen
 * long answers would push the homepage's booking and timetable calls below a
 * wall of text. The questions are written for long-tail comparison searches
 * ("yoga or pilates for beginners", "naturopath or GP") which want a URL of
 * their own to rank, while the homepage should stay pointed at the brand and
 * local intent. And FAQPage structured data belongs on a page whose main
 * content is the question list, not bolted onto a homepage that already carries
 * the business and website nodes.
 *
 * Built for extraction as much as for reading. The answers collapse into native
 * <details> accordions, which costs nothing here: a closed <details> is still
 * in the DOM and in the served HTML, so crawlers and answer engines read it
 * either way. Each answer also has a stable #id to cite, the full text is in
 * the FAQPage node, and the whole list is mirrored into /llms.txt.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { getEntry } from 'astro:content';
import { getPage } from '../lib/content';
import { faqTokens, applyTokens } from '../lib/faq';
import { faqPageNode, breadcrumbNode } from '../lib/schema';

const PATH = '/faq';

const page = await getPage('faq');
const faq = await getEntry('faq', 'general');
if (!faq) throw new Error('FAQ content (src/content/faq/general.yml) is missing.');

const tokens = await faqTokens();
const items = faq.data.items.map((it) => ({ ...it, a: applyTokens(it.a, tokens) }));

/**
 * The schema carries the resolved answers, not the raw ones — an engine quoting
 * a literal "{{address}}" would be worse than no markup at all.
 */
const schema = [
  faqPageNode(items, PATH),
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: PATH },
  ]),
];
---

<BaseLayout fullTitle={page.metaTitle} description={page.metaDescription} path={PATH} schema={schema}>
  <PageHeader eyebrow={page.eyebrow} title={page.heading!} lede={page.lede} />

  <section class="section">
    <div class="container">
      {/* Native <details>, not a scripted accordion. Closed answers stay in the
          DOM and in the HTML source, so collapsing them costs nothing for search
          or answer engines — and the list still works with JavaScript off. */}
      <div class="faq-list">
        {
          items.map((it) => (
            <details class="faq-item" id={it.id}>
              {/* <summary> may contain one heading element, so the h2 outline
                  survives the accordion. Each question stays a top-level topic
                  a reader, a #link and an engine chunking the page can address. */}
              <summary class="faq-summary">
                <h2 class="faq-q">{it.q}</h2>
              </summary>
              <p class="faq-a">{it.a}</p>
            </details>
          ))
        }
      </div>

      {
        faq.data.disclaimer && (
          <p class="faq-disclaimer">{faq.data.disclaimer}</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* One column at a readable measure, centred under the centred page header —
     left-aligning a 72ch column inside a 1200px container just looks unplaced.
     Rows sit flush against each other with hairline rules, so thirteen closed
     questions read as one list rather than thirteen floating cards. */
  .faq-list {
    max-width: 72ch;
    margin-inline: auto;
    border-top: 1px solid var(--color-border);
  }

  /* scroll-margin so a deep link doesn't drop the question under the sticky
     header — the anchors are meant to be shared, so they have to land right. */
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 96px;
  }

  .faq-summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 4px;
    cursor: pointer;
    /* Both are needed to drop the default disclosure triangle: the standard
       property, and the WebKit pseudo-element for older Safari. */
    list-style: none;
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-summary:hover .faq-q { color: var(--color-brand); }
  /* The row is the control, so the focus ring belongs on the whole row. */
  .faq-summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  /* Chevron, drawn from two borders rather than shipped as an asset. Nudged
     down to sit on the first line of the question rather than the box centre,
     which is what keeps two-line questions looking right. */
  .faq-summary::after {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-right: 2px solid var(--color-brand);
    border-bottom: 2px solid var(--color-brand);
    transform: rotate(45deg);
    transition: transform var(--transition);
  }
  .faq-item[open] .faq-summary::after { transform: rotate(-135deg); }
  @media (prefers-reduced-motion: reduce) {
    .faq-summary::after { transition: none; }
  }

  /* Body face at semibold, not the Reborn display face h2 inherits. Reborn is
     built for short uppercase headings; thirteen questions of it — several
     running to two lines — reads as decoration and is genuinely hard to scan.
     "Bold question, plain answer" is also the format the copy was written for. */
  .faq-q {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(1rem, 1.4vw, 1.14rem);
    letter-spacing: 0;
    line-height: 1.4;
    text-transform: none;
    text-wrap: balance;
    color: var(--color-text);
    margin: 0;
    transition: color var(--transition);
  }

  .faq-a {
    margin: 0;
    /* Indent-free, but inset from the chevron column so the answer lines up
       under the question rather than running under the marker. */
    padding: 0 40px 24px 4px;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .faq-disclaimer {
    max-width: 72ch;
    margin-inline: auto;
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>

<script>
  /**
   * Open the answer a deep link points at.
   *
   * The anchors are published — they're cited in /llms.txt and meant to be
   * pasted into replies — so /faq/#referral has to land on an open answer, not
   * a collapsed row that looks like the link went nowhere. Everything else
   * about the accordion is native, so this is the only script on the page, and
   * with it blocked the list still opens and closes on click.
   */
  function openFromHash() {
    if (!location.hash) return;
    const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (!(el instanceof HTMLDetailsElement)) return;
    el.open = true;
    // Re-scroll: the browser already jumped to the row at its collapsed height,
    // which leaves the answer opening below the fold.
    el.scrollIntoView({ block: 'start' });
  }

  openFromHash();
  addEventListener('hashchange', openFromHash);
</script>
