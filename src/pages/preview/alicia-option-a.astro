---
/**
 * PREVIEW — Option A: one combined class page.
 * Alicia's profile stays clean and shows a single "View class times & fees →"
 * link; that link opens THIS page, which gathers all her classes, times and
 * fees in one place. Temporary — delete with src/data/alicia-preview.ts once
 * the client has chosen. Not indexed.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import FeesBox from '@components/FeesBox.astro';
import Icon from '@components/Icon.astro';
import {
  aliciaName, aliciaRole, aliciaImage, aliciaBookingUrl, aliciaPhone,
  aliciaIntro, aliciaClasses, aliciaFeeGroups,
} from '@data/alicia-preview';

const telHref = `tel:${aliciaPhone.replace(/\s/g, '')}`;
---

<BaseLayout title={`${aliciaName} — Classes (Option A preview)`} noindex>
  <div class="pv-banner">
    <div class="container">
      <strong>Preview · Option A — one combined class page.</strong>
      Alicia’s profile would stay clean and show a single
      “View class times &amp; fees →” button that opens this page. All her classes,
      times and fees live together here.
    </div>
  </div>

  <article>
    {/* Hero — same shape as a class/event page */}
    <header class="ev-hero">
      <div class="container ev-hero-inner">
        <div class="ev-hero-copy">
          <p class="eyebrow">Yoga &amp; Meditation · with {aliciaName}</p>
          <h1>Classes with {aliciaName}</h1>
          <p class="lede">{aliciaIntro}</p>
          <div class="ev-actions">
            <a href={aliciaBookingUrl} class="btn btn-primary">Book online</a>
            <a href={telHref} class="btn btn-ghost">Call {aliciaPhone}</a>
          </div>
        </div>
        <div class="ev-hero-media">
          <img src={aliciaImage} alt={`Portrait of ${aliciaName}`} width="440" height="550" />
        </div>
      </div>
    </header>

    {/* Body + combined fees */}
    <div class="section">
      <div class="pv-body">
        <div class="prose">
          <h2>The classes</h2>
          {aliciaClasses.map((c) => (
            <>
              <h3>{c.name}</h3>
              <p>{c.body}</p>
            </>
          ))}
          <p class="pv-note"><Icon name="clock" size={16} /> Please arrive 10 minutes before class to sign in and settle. Payment available in-studio (cash &amp; EFTPOS).</p>
        </div>

        <FeesBox groups={aliciaFeeGroups} heading="Class times &amp; fees" id="fees" />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .pv-banner {
    background: #fff7e6; border-bottom: 1px solid #f2b01e;
    padding: 12px 0; font-size: 14px; color: #6a5218; line-height: 1.5;
  }
  .pv-banner strong { color: #3f3208; }

  .ev-hero {
    background: var(--color-surface-tint);
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(40px, 7vw, 80px);
  }
  .ev-hero-inner { display: grid; grid-template-columns: 1fr 360px; gap: 56px; align-items: center; }
  .ev-hero-media img {
    width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: top;
    border-radius: var(--radius-md); box-shadow: var(--shadow-md);
  }
  .ev-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  .pv-body { max-width: 860px; margin-inline: auto; padding-inline: var(--gutter); }
  .pv-note {
    display: flex; align-items: center; gap: 8px; margin-top: 20px;
    font-size: 14px; color: var(--color-text-muted);
  }
  .pv-note :global(svg) { color: var(--color-accent); flex-shrink: 0; }

  .prose :global(h2) { font-size: 1.4rem; margin: 0 0 0.5em; color: var(--color-heading); }
  .prose :global(h3) { font-size: 1.12rem; margin: 1.4em 0 0.3em; color: var(--color-heading); }
  .prose :global(p) { color: var(--color-text); margin: 0 0 1em; max-width: none; }

  @media (max-width: 820px) {
    .ev-hero-inner { grid-template-columns: 1fr; }
    .ev-hero-media { order: -1; max-width: 300px; }
  }
</style>
