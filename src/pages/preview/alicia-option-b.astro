---
/**
 * PREVIEW — Option B: times & fees directly on Alicia's profile.
 * Her practitioner profile carries the full class times & fees inline (like
 * Amanda's seminar box), with no separate class page. Temporary — delete with
 * src/data/alicia-preview.ts once the client has chosen. Not indexed.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import FeesBox from '@components/FeesBox.astro';
import Icon from '@components/Icon.astro';
import {
  aliciaName, aliciaRole, aliciaImage, aliciaBookingUrl, aliciaPhone,
  aliciaClasses, aliciaFeeGroups,
} from '@data/alicia-preview';

const telHref = `tel:${aliciaPhone.replace(/\s/g, '')}`;
const firstName = aliciaName.split(' ')[0];
---

<BaseLayout title={`${aliciaName} (Option B preview)`} noindex>
  <div class="pv-banner">
    <div class="container">
      <strong>Preview · Option B — times &amp; fees on the profile.</strong>
      Alicia’s class times and fees sit directly on her own profile page (like
      Amanda’s seminar box), with no separate class page to click through to.
    </div>
  </div>

  {/* Hero — same shape as a practitioner profile */}
  <header class="prac-hero">
    <div class="container prac-hero-inner">
      <div class="prac-hero-photo">
        <img src={aliciaImage} alt={`Portrait of ${aliciaName}`} width="440" height="550" />
      </div>
      <div class="prac-hero-info">
        <p class="eyebrow">{aliciaRole}</p>
        <h1>{aliciaName}</h1>
        <div class="prac-hero-actions">
          <a href={aliciaBookingUrl} class="btn btn-primary">Book online</a>
          <a href={telHref} class="btn btn-ghost">Call {aliciaPhone}</a>
        </div>
      </div>
    </div>
  </header>

  {/* Bio + inline fees */}
  <article class="section">
    <div class="prac-body">
      <div class="prose">
        <p>
          Inclusive, empowering yoga that blends traditional practice with
          evidence-based, trauma-informed teaching. {firstName} teaches gentle
          Seniors Yoga, general Yoga &amp; Meditation and evening Yin, plus 1:1
          private sessions in-person and online.
        </p>
        <h2>The classes</h2>
        {aliciaClasses.map((c) => (
          <>
            <h3>{c.name}</h3>
            <p>{c.body}</p>
          </>
        ))}
        <p class="pv-note"><Icon name="clock" size={16} /> Please arrive 10 minutes before class to sign in and settle. Payment available in-studio (cash &amp; EFTPOS).</p>
      </div>

      <FeesBox groups={aliciaFeeGroups} heading="Class times &amp; fees" />

      <section class="book-cta">
        <h2>Ready to book with {firstName}?</h2>
        <div class="book-cta-actions">
          <a href={aliciaBookingUrl} class="btn btn-primary">Book online</a>
          <a href={telHref} class="btn btn-ghost">Call {aliciaPhone}</a>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .pv-banner {
    background: #fff7e6; border-bottom: 1px solid #f2b01e;
    padding: 12px 0; font-size: 14px; color: #6a5218; line-height: 1.5;
  }
  .pv-banner strong { color: #3f3208; }

  .prac-hero {
    background: var(--color-surface-tint);
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(40px, 7vw, 80px);
  }
  .prac-hero-inner { display: grid; grid-template-columns: 360px 1fr; gap: 56px; align-items: center; }
  .prac-hero-photo img {
    width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: top;
    border-radius: var(--radius-md); box-shadow: var(--shadow-md);
    filter: saturate(0.92) contrast(1.02);
  }
  .prac-hero-info h1 { margin-bottom: 12px; }
  .prac-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .prac-body { max-width: 860px; margin-inline: auto; padding-inline: var(--gutter); }
  .pv-note {
    display: flex; align-items: center; gap: 8px; margin-top: 20px;
    font-size: 14px; color: var(--color-text-muted);
  }
  .pv-note :global(svg) { color: var(--color-accent); flex-shrink: 0; }

  .prose :global(h2) { font-size: 1.4rem; margin: 1.6em 0 0.5em; color: var(--color-heading); }
  .prose :global(h3) { font-size: 1.12rem; margin: 1.4em 0 0.3em; color: var(--color-heading); }
  .prose :global(p) { color: var(--color-text); margin: 0 0 1em; max-width: none; }

  .book-cta {
    margin-top: 52px; text-align: center;
    background: var(--color-surface-tint); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: 40px 24px;
  }
  .book-cta h2 { font-size: 1.5rem; margin-bottom: 20px; }
  .book-cta-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 820px) {
    .prac-hero-inner { grid-template-columns: 1fr; gap: 28px; }
    .prac-hero-photo { max-width: 300px; }
  }
</style>
