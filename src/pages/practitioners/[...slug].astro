---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PlaceholderImage from '@components/PlaceholderImage.astro';
import CtaBand from '@components/CtaBand.astro';

export async function getStaticPaths() {
  const practitioners = await getCollection('practitioners');
  return practitioners.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, role, image, bookingUrl, phone, service, modalities, placeholder } = entry.data;

const svc = service ? await getEntry('services', service) : undefined;
const telHref = phone ? `tel:${phone.replace(/\s/g, '')}` : undefined;
---

<BaseLayout
  title={name}
  description={`${name} — ${role} at Health Hub Tweed Coast, Hastings Point.`}
  path={`/practitioners/${entry.id}`}
>
  {/* Hero */}
  <header class="prac-hero">
    <div class="container prac-hero-inner">
      <div class="prac-hero-photo">
        {
          image ? (
            <img src={image} alt={`Portrait of ${name}`} width="440" height="550" />
          ) : (
            <PlaceholderImage label="Portrait" ratio="4/5" icon="👤" />
          )
        }
      </div>
      <div class="prac-hero-info">
        <p class="eyebrow">{role}</p>
        <h1>{name}</h1>
        {svc && (
          <a class="svc-chip" href={`/services/${svc.id}`}>
            {svc.data.shortTitle ?? svc.data.title} →
          </a>
        )}
        {modalities.length > 0 && <p class="prac-modalities">{modalities.join(' · ')}</p>}
        <div class="prac-hero-actions">
          {bookingUrl && <a href={bookingUrl} class="btn btn-primary">Book online</a>}
          {telHref && <a href={telHref} class="btn btn-ghost">Call {phone}</a>}
          {!bookingUrl && !telHref && <a href="/booking" class="btn btn-primary">Make a booking</a>}
        </div>
        {placeholder && <p class="ph-note">Placeholder bio — migrated in Phase 3.</p>}
      </div>
    </div>
  </header>

  {/* Full bio */}
  <article class="section">
    <div class="prac-body">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <CtaBand />
</BaseLayout>

<style>
  .prac-hero {
    background: var(--color-surface-tint);
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(40px, 7vw, 80px);
  }
  .prac-hero-inner {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 56px;
    align-items: center;
  }
  .prac-hero-photo img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }
  .prac-hero-info h1 { margin-bottom: 12px; }
  .svc-chip {
    display: inline-block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-brand);
  }
  .prac-modalities { color: var(--color-text-muted); margin-top: 14px; }
  .prac-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .ph-note { font-size: 12px; color: var(--color-text-muted); font-style: italic; margin-top: 14px; }

  .prac-body { max-width: 820px; margin-inline: auto; padding-inline: var(--gutter); }

  @media (max-width: 820px) {
    .prac-hero-inner { grid-template-columns: 1fr; gap: 28px; }
    .prac-hero-photo { max-width: 300px; }
  }

  /* ---- Prose: bio content. Bio subheadings use the body font (Noah), not
     the uppercase display face, and modest sizes so dense content (fees,
     class times) reads as normal subheadings. ---- */
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-sans);
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-heading);
    line-height: 1.3;
    margin: 1.8em 0 0.5em;
  }
  .prose :global(h2) { font-size: 1.35rem; }
  .prose :global(h3) { font-size: 1.1rem; }
  .prose :global(h4) { font-size: 1rem; }
  .prose :global(p) { color: var(--color-text); margin: 0 0 1em; max-width: none; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.2em; padding-left: 1.3em; }
  .prose :global(li) { margin-bottom: 0.4em; color: var(--color-text); }
  .prose :global(strong) { color: var(--color-heading); }
  .prose :global(blockquote) {
    margin: 1.4em 0;
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--color-accent);
    color: var(--color-text-muted);
    font-style: italic;
  }
  .prose :global(hr) { border: none; border-top: 1px solid var(--color-border); margin: 2em 0; }
</style>
