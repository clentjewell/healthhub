---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PlaceholderImage from '@components/PlaceholderImage.astro';
import CtaBand from '@components/CtaBand.astro';

export async function getStaticPaths() {
  const practitioners = await getCollection('practitioners');
  return practitioners.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  name, role, image, bookingUrl, phone, service, modalities,
  facebook, instagram, website, sessions, placeholder,
} = entry.data;

const svc = service ? await getEntry('services', service) : undefined;
const telHref = phone ? `tel:${phone.replace(/\s/g, '')}` : undefined;
const socials = [
  facebook && { label: 'Facebook', href: facebook, icon: 'f' },
  instagram && { label: 'Instagram', href: instagram, icon: 'ig' },
  website && { label: 'Website', href: website, icon: 'web' },
].filter(Boolean) as { label: string; href: string; icon: string }[];
---

<BaseLayout
  title={name}
  description={`${name} — ${role} at Health Hub Tweed Coast, Hastings Point.`}
  path={`/practitioners/${entry.id}`}
>
  {/* Hero */}
  <header class="prac-hero">
    <div class="container prac-hero-inner">
      <div class="prac-hero-photo">
        {
          image ? (
            <img src={image} alt={`Portrait of ${name}`} width="440" height="550" />
          ) : (
            <PlaceholderImage label="Portrait" ratio="4/5" icon="👤" />
          )
        }
      </div>
      <div class="prac-hero-info">
        <p class="eyebrow">{role}</p>
        <h1>{name}</h1>
        {svc && (
          <a class="svc-chip" href={`/services/${svc.id}`}>{svc.data.shortTitle ?? svc.data.title} →</a>
        )}
        {modalities.length > 0 && <p class="prac-modalities">{modalities.join(' · ')}</p>}
        <div class="prac-hero-actions">
          {bookingUrl && <a href={bookingUrl} class="btn btn-primary">Book online</a>}
          {telHref && <a href={telHref} class="btn btn-ghost">Call {phone}</a>}
          {!bookingUrl && !telHref && <a href="/booking" class="btn btn-primary">Make a booking</a>}
        </div>
        {
          socials.length > 0 && (
            <ul class="prac-social" aria-label={`${name} on social media`}>
              {socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
                    {s.icon === 'f' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9h3l.4-3H14V4.2c0-.9.3-1.5 1.6-1.5H17V.1C16.6 0 15.6 0 14.5 0 12 0 10.3 1.5 10.3 4.3V6H7v3h3.3v9H14z"/></svg>}
                    {s.icon === 'ig' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .4 1.4.8.4.4.6.8.8 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.4 1-.8 1.4-.4.4-.8.6-1.4.8-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.4-1.4-.8-.4-.4-.6-.8-.8-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.4-1 .8-1.4.4-.4.8-.6 1.4-.8.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2m0 1.9c-3.1 0-3.5 0-4.8.1-.9 0-1.4.2-1.7.3-.4.2-.7.3-1 .6-.3.3-.5.6-.6 1-.1.3-.3.8-.3 1.7-.1 1.3-.1 1.7-.1 4.8s0 3.5.1 4.8c0 .9.2 1.4.3 1.7.2.4.3.7.6 1 .3.3.6.5 1 .6.3.1.8.3 1.7.3 1.3.1 1.7.1 4.8.1s3.5 0 4.8-.1c.9 0 1.4-.2 1.7-.3.4-.2.7-.3 1-.6.3-.3.5-.6.6-1 .1-.3.3-.8.3-1.7.1-1.3.1-1.7.1-4.8s0-3.5-.1-4.8c0-.9-.2-1.4-.3-1.7-.2-.4-.3-.7-.6-1-.3-.3-.6-.5-1-.6-.3-.1-.8-.3-1.7-.3-1.3-.1-1.7-.1-4.8-.1m0 3.2a4.7 4.7 0 110 9.4 4.7 4.7 0 010-9.4m0 7.7a3 3 0 100-6 3 3 0 000 6m6-7.9a1.1 1.1 0 11-2.2 0 1.1 1.1 0 012.2 0"/></svg>}
                    {s.icon === 'web' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 100 20 10 10 0 000-20m0 2c1.5 0 3.7 2.3 4.3 6H7.7C8.3 6.3 10.5 4 12 4M6.1 8H4.6A8 8 0 019 4.6 12 12 0 006.1 8m-.7 2h-1A8 8 0 004 12c0 .7.1 1.4.3 2h1.4c-.1-.6-.2-1.3-.2-2s.1-1.4.2-2m2 0h9.2c.1.6.2 1.3.2 2s-.1 1.4-.2 2H7.4c-.1-.6-.2-1.3-.2-2s.1-1.4.2-2m11.2 0h1.4c.2.6.3 1.3.3 2s-.1 1.4-.3 2h-1.4c.1-.6.2-1.3.2-2s-.1-1.4-.2-2M4.6 16h1.5a12 12 0 002.9 3.4A8 8 0 014.6 16m4.1 0h6.6c-.6 3.7-2.8 6-4.3 6s-3.7-2.3-4.3-6m9.3 0h1.4a8 8 0 01-4.3 3.4 12 12 0 002.9-3.4"/></svg>}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        {placeholder && <p class="ph-note">Placeholder bio — migrated in Phase 3.</p>}
      </div>
    </div>
  </header>

  {/* Bio */}
  <article class="section prac-section">
    <div class="prac-body">
      <div class="prose">
        <Content />
      </div>

      {
        sessions.length > 0 && (
          <section class="sessions">
            <h2 class="sessions-h">Sessions &amp; Fees</h2>
            <div class="sessions-grid">
              {sessions.map((s) => (
                <div class="session-card">
                  <div class="session-top">
                    <span class="session-label">{s.label}</span>
                    {s.price && <span class="session-price">{s.price}</span>}
                  </div>
                  {s.note && <p class="session-note">{s.note}</p>}
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>

  <CtaBand />
</BaseLayout>

<style>
  .prac-hero {
    background: var(--color-surface-tint);
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(40px, 7vw, 80px);
  }
  .prac-hero-inner { display: grid; grid-template-columns: 360px 1fr; gap: 56px; align-items: center; }
  .prac-hero-photo img {
    width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: top;
    border-radius: var(--radius-md); box-shadow: var(--shadow-md);
  }
  .prac-hero-info h1 { margin-bottom: 12px; }
  .svc-chip {
    display: inline-block; background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 999px; padding: 6px 16px; font-size: 13px; font-weight: 600; color: var(--color-brand);
  }
  .prac-modalities { color: var(--color-text-muted); margin-top: 14px; }
  .prac-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .prac-social { display: flex; gap: 12px; list-style: none; padding: 0; margin: 22px 0 0; }
  .prac-social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-brand);
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }
  .prac-social a:hover { background: var(--color-brand); color: #fff; border-color: var(--color-brand); }
  .prac-social svg { width: 18px; height: 18px; fill: currentColor; }
  .ph-note { font-size: 12px; color: var(--color-text-muted); font-style: italic; margin-top: 14px; }

  .prac-body { max-width: 820px; margin-inline: auto; padding-inline: var(--gutter); }

  /* Sessions & Fees boxes */
  .sessions { margin-top: 48px; }
  .sessions-h { font-size: 1.5rem; margin-bottom: 20px; }
  .sessions-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .session-card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: 20px 22px;
  }
  .session-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .session-label { font-weight: 700; color: var(--color-heading); line-height: 1.3; }
  .session-price {
    font-weight: 700; color: var(--color-accent); white-space: nowrap; font-size: 1.05rem;
  }
  .session-note { font-size: 13px; color: var(--color-text-muted); margin: 8px 0 0; }
  @media (max-width: 620px) { .sessions-grid { grid-template-columns: 1fr; } }

  @media (max-width: 820px) {
    .prac-hero-inner { grid-template-columns: 1fr; gap: 28px; }
    .prac-hero-photo { max-width: 300px; }
  }

  /* Prose — bio content. Subheadings use the body font, BOLD + brand colour
     so they're prominent; dense schedule content reads cleanly. */
  .prose :global(h2), .prose :global(h3), .prose :global(h4) {
    font-family: var(--font-sans); text-transform: none; letter-spacing: 0;
    color: var(--color-heading); font-weight: 700; line-height: 1.3; margin: 1.8em 0 0.5em;
  }
  .prose :global(h2) { font-size: 1.4rem; }
  .prose :global(h3) { font-size: 1.12rem; }
  .prose :global(h4) { font-size: 1rem; }
  .prose :global(p) { color: var(--color-text); margin: 0 0 1em; max-width: none; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.2em; padding-left: 1.3em; }
  .prose :global(li) { margin-bottom: 0.4em; color: var(--color-text); }
  .prose :global(strong) { color: var(--color-heading); font-weight: 700; }
  .prose :global(blockquote) {
    margin: 1.4em 0; padding: 4px 0 4px 20px; border-left: 3px solid var(--color-accent);
    color: var(--color-text-muted); font-style: italic;
  }
</style>
