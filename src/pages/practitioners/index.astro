---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import PractitionerCard from '@components/PractitionerCard.astro';
import CtaBand from '@components/CtaBand.astro';

const practitioners = (await getCollection('practitioners')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Our Practitioners"
  description="Meet the practitioners and teachers at Health Hub Tweed Coast, Hastings Point."
>
  <PageHeader
    eyebrow="Meet the team"
    title="Our Practitioners"
    lede="A multidisciplinary team of practitioners and teachers, here to support you."
  />

  <section class="section">
    <div class="container">
      <div class="grid-practitioners">
        {
          practitioners.map((p) => (
            <PractitionerCard
              name={p.data.name}
              role={p.data.role}
              href={`/practitioners/${p.id}`}
              image={p.data.image}
              modalities={p.data.modalities}
              placeholder={p.data.placeholder}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .grid-practitioners {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  @media (max-width: 900px) { .grid-practitioners { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .grid-practitioners { grid-template-columns: 1fr; } }
</style>
