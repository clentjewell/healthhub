---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PlaceholderImage from '@components/PlaceholderImage.astro';
import Icon from '@components/Icon.astro';
import CtaBand from '@components/CtaBand.astro';
import { personNode, breadcrumbNode } from '../../lib/schema';
import { clamp } from '../../lib/seo';

export async function getStaticPaths() {
  const practitioners = await getCollection('practitioners');
  return practitioners.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  name, role, image, bookingUrl, phone, service, modalities,
  facebook, instagram, website, feeGroups, placeholder,
} = entry.data;

const svc = service ? await getEntry('services', service) : undefined;
const telHref = phone ? `tel:${phone.replace(/\s/g, '')}` : undefined;
const parts = name.split(' ');
const firstName = parts[0] === 'Dr' ? parts[1] ?? name : parts[0];
const socials = [
  facebook && { label: 'Facebook', href: facebook, icon: 'facebook' as const },
  instagram && { label: 'Instagram', href: instagram, icon: 'instagram' as const },
  website && { label: 'Website', href: website, icon: 'globe' as const },
].filter(Boolean) as { label: string; href: string; icon: 'facebook' | 'instagram' | 'globe' }[];

/**
 * Search intent for a studio like this is "acupuncturist Hastings Point" far
 * more often than a practitioner's name, so the service goes in the title and
 * the role plus the service's own words go in the description. The short service
 * label keeps the title inside what Google renders.
 */
const svcShort = svc?.data.shortTitle ?? svc?.data.title;
const metaTitle = svcShort ? `${name}, ${svcShort}` : name;
const description = clamp(
  `${name}, ${role} at Health Hub Tweed Coast in Hastings Point.` +
    `${svc ? ` ${svc.data.summary}` : ''}`,
);
const schema = [
  personNode({
    id: entry.id,
    name, role, image, phone, facebook, instagram, website,
    serviceTitle: svc?.data.title,
    summary: description,
  }),
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: 'Practitioners', path: '/our-practitioners' },
    { name, path: `/our-practitioner/${entry.id}` },
  ]),
];
---

<BaseLayout
  title={metaTitle}
  description={description}
  path={`/our-practitioner/${entry.id}`}
  ogImage={image ?? '/assets/og-default.jpg'}
  ogType="profile"
  schema={schema}
>
  {/* Hero */}
  <header class="prac-hero">
    <div class="container prac-hero-inner">
      <div class="prac-hero-photo">
        {
          image ? (
            <img src={image} alt={`Portrait of ${name}`} width="440" height="550" />
          ) : (
            <PlaceholderImage label="Portrait" ratio="4/5" icon="user" />
          )
        }
      </div>
      <div class="prac-hero-info">
        <p class="eyebrow">{role}</p>
        <h1>{name}</h1>
        {svc && <span class="svc-chip">{svc.data.shortTitle ?? svc.data.title}</span>}
        {modalities.length > 0 && <p class="prac-modalities">{modalities.join(' · ')}</p>}
        <div class="prac-hero-actions">
          {bookingUrl && <a href={bookingUrl} class="btn btn-primary">Book online</a>}
          {telHref && <a href={telHref} class="btn btn-ghost">Call {phone}</a>}
          {!bookingUrl && !telHref && <a href="/make-a-booking" class="btn btn-primary">Make a booking</a>}
        </div>
        {
          socials.length > 0 && (
            <ul class="prac-social" aria-label={`${name} on social media`}>
              {socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
                    <Icon name={s.icon} size={18} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        {placeholder && import.meta.env.DEV && <p class="ph-note">Placeholder bio — migrated in Phase 3.</p>}
      </div>
    </div>
  </header>

  {/* Bio */}
  <article class="section prac-section">
    <div class="prac-body">
      <div class="prose">
        <Content />
      </div>

      {
        feeGroups.length > 0 && (
          <section class="fees">
            <h2 class="fees-h">Sessions &amp; Fees</h2>
            <div class="fees-grid">
              {feeGroups.map((g) => (
                <div class="fee-box">
                  <div class="fee-head">
                    <h3>{g.title}</h3>
                    {g.price && <span class="fee-price">{g.price}</span>}
                  </div>
                  {g.duration && <p class="fee-duration">{g.duration}</p>}
                  {g.note && <p class="fee-note">{g.note}</p>}
                  {g.items.length > 0 && (
                    <ul class="fee-list">
                      {g.items.map((it) => (
                        <li>
                          <span class="fee-label">{it.label}</span>
                          {it.price && <span class="fee-price-sm">{it.price}</span>}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </section>
        )
      }

      {/* Book now */}
      <section class="book-cta">
        <h2>Ready to book with {firstName}?</h2>
        <div class="book-cta-actions">
          {bookingUrl && <a href={bookingUrl} class="btn btn-primary">Book online</a>}
          {telHref && <a href={telHref} class="btn btn-ghost">Call {phone}</a>}
          {!bookingUrl && !telHref && <a href="/make-a-booking" class="btn btn-primary">Make a booking</a>}
        </div>
      </section>
    </div>
  </article>

  <CtaBand />
</BaseLayout>

<style>
  .prac-hero {
    background: var(--color-surface-tint);
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(40px, 7vw, 80px);
  }
  .prac-hero-inner { display: grid; grid-template-columns: 360px 1fr; gap: 56px; align-items: center; }
  .prac-hero-photo img {
    width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: top;
    border-radius: var(--radius-md); box-shadow: var(--shadow-md);
    filter: saturate(0.92) contrast(1.02);
  }
  .prac-hero-info h1 { margin-bottom: 12px; }
  .svc-chip {
    display: inline-flex; align-items: center; min-height: 44px;
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 999px; padding: 8px 18px; font-size: 13px; font-weight: 600; color: var(--color-brand);
  }
  .prac-modalities { color: var(--color-text-muted); margin-top: 14px; }
  .prac-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .prac-social { display: flex; gap: 12px; list-style: none; padding: 0; margin: 22px 0 0; }
  .prac-social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-brand);
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }
  .prac-social a:hover { background: var(--color-brand); color: #fff; border-color: var(--color-brand); }
  .prac-social svg { width: 18px; height: 18px; fill: currentColor; }
  .ph-note { font-size: 12px; color: var(--color-text-muted); font-style: italic; margin-top: 14px; }

  .prac-body { max-width: 860px; margin-inline: auto; padding-inline: var(--gutter); }

  /* Sessions & Fees — grouped boxes */
  .fees { margin-top: 52px; }
  .fees-h { font-size: 1.5rem; margin-bottom: 20px; }
  .fees-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .fee-box {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: 22px 24px;
  }
  .fee-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .fee-head h3 { font-size: 1.05rem; color: var(--color-heading); line-height: 1.3; }
  .fee-price { font-weight: 700; color: var(--color-accent); font-size: 1.05rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .fee-duration {
    font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-accent); font-weight: 600; margin: 6px 0 0;
  }
  .fee-note { font-size: 13px; color: var(--color-text-muted); margin: 8px 0 0; line-height: 1.5; }
  .fee-list { list-style: none; margin: 14px 0 0; padding: 0; }
  .fee-list li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    padding: 8px 0; border-top: 1px solid var(--color-surface-tint);
  }
  .fee-list li:first-child { border-top: none; }
  .fee-label { color: var(--color-text); font-size: 14px; }
  .fee-price-sm { font-weight: 700; color: var(--color-accent); white-space: nowrap; font-variant-numeric: tabular-nums; }

  /* Book now */
  .book-cta {
    margin-top: 52px; text-align: center;
    background: var(--color-surface-tint); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); padding: 40px 24px;
  }
  .book-cta h2 { font-size: 1.5rem; margin-bottom: 20px; }
  .book-cta-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 820px) {
    .prac-hero-inner { grid-template-columns: 1fr; gap: 28px; }
    .prac-hero-photo { max-width: 300px; }
  }

  /* Prose */
  .prose :global(h2), .prose :global(h3), .prose :global(h4) {
    font-family: var(--font-sans); text-transform: none; letter-spacing: 0;
    color: var(--color-heading); font-weight: 700; line-height: 1.3; margin: 1.8em 0 0.5em;
  }
  .prose :global(h2) { font-size: 1.4rem; }
  .prose :global(h3) { font-size: 1.12rem; }
  .prose :global(h4) { font-size: 1rem; }
  .prose :global(p) { color: var(--color-text); margin: 0 0 1em; max-width: none; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.2em; padding-left: 1.3em; }
  .prose :global(li) { margin-bottom: 0.4em; color: var(--color-text); }
  /* Body copy resolves to Noah Bold (700) — the family has no upright 400, same
     as Pottsville. So emphasis has to step up to Black or it is invisible. */
  .prose :global(strong) { color: var(--color-heading); font-weight: 900; }
  .prose :global(blockquote) {
    margin: 1.4em 0; padding: 4px 0 4px 20px; border-left: 3px solid var(--color-accent);
    color: var(--color-text-muted); font-style: italic;
  }
</style>
