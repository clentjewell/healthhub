---
/**
 * Design proposal for pottsvilleacupuncture.com.au/hub/ (Prompt 2).
 *
 * Their current page describes the Hub well but sends every concrete question
 * off-site: it links to healthhubtweedcoast.com.au and stops. The proposal keeps
 * their copy and their voice, and adds the two things a visitor actually wants
 * before they commit — what is on this week, and who they will meet — pulled
 * live from the Health Hub content collections so it can never go stale.
 *
 * Copy in the narrative sections is Pottsville's own, taken from the live page.
 * Nothing about their practice is invented here.
 */
import { getCollection, getEntry } from 'astro:content';
import ProposalLayout from '@layouts/ProposalLayout.astro';

const timetable = await getEntry('timetable', 'weekly');
const days = (timetable?.data.days ?? []).filter((d) => d.sessions.length > 0);

const practitioners = (await getCollection('practitioners')).sort(
  (a, b) => a.data.order - b.data.order,
);
const team = await Promise.all(
  practitioners.map(async (p) => {
    const svc = p.data.service ? await getEntry('services', p.data.service) : undefined;
    return {
      name: p.data.name,
      role: p.data.role,
      image: p.data.image,
      service: svc?.data.shortTitle ?? svc?.data.title,
    };
  }),
);

/** Class count, so the copy states a real number rather than "lots". */
const classCount = days.reduce((n, d) => n + d.sessions.length, 0);

/** The three pillars — Pottsville's own words from the live /hub/ page. */
const pillars = [
  {
    title: 'Clinic',
    body:
      'The same first-person care you know from Pottsville Acupuncture. Multiple treatment ' +
      'rooms, multiple practitioners — all bookable directly through the same Halaxy system.',
  },
  {
    title: 'Programs',
    body:
      'Small-group programs built around our nine symptom areas — Pregnancy Programme, ' +
      'Family Care, Wellness Path, and seasonal offerings. Running now.',
  },
  {
    title: 'Retreat space',
    body:
      'A peaceful studio for guided sessions, post-treatment recovery, and the kind of ' +
      'unhurried decompression patients ask us for.',
  },
];
---

<ProposalLayout
  title="Hastings Wellness Hub — Pottsville Acupuncture (proposal)"
  proposalFor="pottsvilleacupuncture.com.au/hub/"
>
  {/* ---------- Hero ---------- */}
  <section class="h-hero">
    <div class="h-hero-bg" aria-hidden="true"></div>
    <div class="container h-hero-inner">
      <p class="eyebrow h-hero-eyebrow">Hastings Wellness Hub</p>
      <h1>The philosophy made physical.</h1>
      <p class="h-hero-lede">
        A destination at Hastings Point where clinic, programs, classes and community come
        together. A studio where small-group programs, yoga, exercise and lifestyle classes
        support the everyday rhythm of whole-person integrative care.
      </p>
      <div class="h-hero-actions">
        <a href="#this-week" class="btn btn-white">See this week's classes</a>
        <a href="https://www.healthhubtweedcoast.com.au/" class="btn btn-ghost">
          Visit the Hub
        </a>
      </div>
      <p class="h-hero-meta">
        87–89 Tweed Coast Road, Hastings Point · {classCount} classes a week · Open now
      </p>
    </div>
  </section>

  {/* ---------- Three pillars ---------- */}
  <section class="section h-pillars">
    <div class="container">
      <div class="h-head">
        <p class="eyebrow">One roof</p>
        <h2>Clinic and Studio, one rhythm.</h2>
        <p class="h-lede">
          The Hub draws together clinical practice, group education, and quiet recovery — under
          one roof on the Tweed Coast. Built around the same balanced integration philosophy that
          has guided Pottsville Acupuncture for thirty-five years.
        </p>
      </div>
      <ul class="h-pillar-grid">
        {
          pillars.map((p, i) => (
            <li class="h-pillar">
              <span class="h-pillar-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------- Live timetable — the addition ---------- */}
  <section class="section h-week" id="this-week">
    <div class="container">
      <div class="h-head">
        <p class="eyebrow">On now</p>
        <h2>This week at the Hub.</h2>
        <p class="h-lede">
          Every class running in the studio, kept current automatically. Classes are led by the
          Hub's own teachers, who each take their own bookings.
        </p>
      </div>
      <ul class="h-week-grid">
        {
          days.map((d) => (
            <li class="h-day">
              <h3>{d.day}</h3>
              <ul>
                {
                  d.sessions.map((s) => (
                    <li>
                      <span class="h-class">{s.name}</span>
                      <span class="h-time">{s.time}</span>
                    </li>
                  ))
                }
              </ul>
            </li>
          ))
        }
      </ul>
      <p class="h-week-more">
        <a href="https://www.healthhubtweedcoast.com.au/events/" class="btn btn-primary">
          Full timetable &amp; bookings
        </a>
      </p>
    </div>
  </section>

  {/* ---------- Quote ---------- */}
  <section class="h-quote">
    <div class="container">
      <blockquote>
        &#8220;The Wellness Hub is the place where it all comes together. The clinic, the programs,
        the practice — in one space, on the Tweed Coast, designed for the way people actually
        heal.&#8221;
      </blockquote>
      <p class="h-quote-by">Dr Mal McKay · Pottsville Acupuncture</p>
    </div>
  </section>

  {/* ---------- Who you'll meet — the addition ---------- */}
  <section class="section h-team">
    <div class="container">
      <div class="h-head">
        <p class="eyebrow">The studio</p>
        <h2>Who you'll meet.</h2>
        <p class="h-lede">
          {team.length} practitioners and teachers work from the Hub, each leading their own
          discipline alongside the clinic.
        </p>
      </div>
      <ul class="h-team-grid">
        {
          team.map((t) => (
            <li class="h-member">
              {t.image ? (
                <img src={t.image} alt={`Portrait of ${t.name}`} loading="lazy" width="240" height="300" />
              ) : (
                <div class="h-member-ph" aria-hidden="true"></div>
              )}
              <h3>{t.name}</h3>
              <p>{t.service ?? t.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------- One ecosystem ---------- */}
  <section class="section h-eco">
    <div class="container">
      <div class="h-head">
        <p class="eyebrow">Together</p>
        <h2>One ecosystem.</h2>
      </div>
      <div class="h-eco-grid">
        <div class="h-eco-card">
          <h3>Already with Pottsville?</h3>
          <p>
            If you're a Pottsville Acupuncture client, the Hub is where further supportive care,
            integration and community become one. The care and philosophy is the same — with more
            capacity to meet you at the right time.
          </p>
          <a href="https://pottsvilleacupuncture.com.au/book/" class="btn btn-primary">
            Book an appointment
          </a>
        </div>
        <div class="h-eco-card">
          <h3>New to us?</h3>
          <p>
            If you're new to us, check out our schedule for a class or program that suits you.
            We're at 87–89 Tweed Coast Road, Hastings Point.
          </p>
          <a href="https://www.healthhubtweedcoast.com.au/" class="btn btn-ghost-dark">
            Visit healthhubtweedcoast.com.au →
          </a>
        </div>
      </div>
    </div>
  </section>
</ProposalLayout>

<style>
  /* ---------- Shared section furniture (Pottsville rhythm: 96px) ---------- */
  .section { padding-block: 96px; }
  .h-head { max-width: 64ch; margin-bottom: 48px; }
  .h-head h2 { margin-top: 10px; }
  .h-lede {
    margin-top: 18px;
    font-size: var(--fs-lede);
    color: var(--p-grey-500);
  }

  /* ---------- Hero ---------- */
  .h-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(74vh, 640px);
    padding-block: clamp(88px, 13vw, 150px);
    color: #fff;
    overflow: hidden;
    background: var(--p-deep);
  }
  /* Their page uses a family photograph here. This uses a Health Hub studio
     image, which we own — the real asset swaps in without touching layout. */
  .h-hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgba(13, 110, 112, 0.93) 0%, rgba(13, 110, 112, 0.72) 55%,
        rgba(29, 191, 193, 0.45) 100%),
      url('/images/hero-2.webp') center / cover no-repeat;
  }
  .h-hero-inner { position: relative; z-index: 1; width: 100%; }
  .h-hero-eyebrow { color: #fff; opacity: 0.92; }
  .h-hero h1 { color: #fff; max-width: 22ch; margin-top: 14px; }
  .h-hero-lede {
    margin-top: 22px;
    max-width: 58ch;
    font-size: var(--fs-lede);
    color: rgba(255, 255, 255, 0.92);
  }
  .h-hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .btn-white { background: #fff; color: var(--p-deep); font-weight: 700; }
  .btn-white:hover { background: var(--p-tint); color: var(--p-deep); }
  .h-hero .btn-ghost { background: transparent; color: #fff; border: 1px solid rgba(255, 255, 255, 0.45); }
  .h-hero .btn-ghost:hover { background: rgba(255, 255, 255, 0.14); border-color: #fff; }
  .h-hero-meta {
    margin-top: 30px;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.78);
  }

  /* ---------- Pillars ---------- */
  .h-pillars { background: #fff; }
  .h-pillar-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .h-pillar {
    padding: 30px 28px 32px;
    background: var(--p-paper);
    border: 1px solid var(--p-grey-100);
    border-radius: 12px;
    border-top: 3px solid var(--p-hero);
  }
  .h-pillar-n {
    display: block;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--p-hero);
  }
  .h-pillar h3 { margin: 12px 0 10px; font-size: 1.25rem; }
  .h-pillar p { color: var(--p-grey-500); font-size: 15px; margin: 0; }

  /* ---------- This week ---------- */
  .h-week { background: var(--p-tint); }
  .h-week-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Narrow enough that a full week fits on one row — at 190px the sixth day
       wrapped and sat alone against four empty columns. auto-fit collapses the
       spare track, so 6 or 7 days both spread evenly. */
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 18px;
  }
  .h-day {
    background: #fff;
    border: 1px solid var(--p-grey-100);
    border-radius: 12px;
    padding: 22px 22px 24px;
  }
  .h-day h3 {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--p-deep);
    margin: 0 0 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--p-grey-100);
  }
  .h-day ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .h-class { display: block; font-weight: 700; font-size: 14.5px; color: var(--p-grey-700); line-height: 1.35; }
  .h-time {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--p-hero);
    font-variant-numeric: tabular-nums;
    margin-top: 3px;
  }
  .h-week-more { margin-top: 40px; max-width: none; display: flex; justify-content: center; }

  /* ---------- Quote ---------- */
  .h-quote {
    background: var(--p-deep);
    color: #fff;
    padding-block: 88px;
    text-align: center;
  }
  /* Reborn is a wide, uppercase display face — five lines of it is a wall. The
     italic is also the only genuine regular-weight face in the licensed Noah
     set, so an italic pull-quote reads lighter than anything else on the page. */
  .h-quote blockquote {
    margin: 0 auto;
    max-width: 46ch;
    font-family: var(--font-sans);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.3rem, 2.3vw, 1.85rem);
    line-height: 1.5;
    letter-spacing: 0;
    text-transform: none;
  }
  .h-quote-by {
    margin-top: 26px;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--p-hero);
  }

  /* ---------- Team ---------- */
  .h-team { background: var(--p-hub-sand); }
  .h-team-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .h-member { text-align: center; }
  .h-member img,
  .h-member-ph {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: top;
    border-radius: 12px;
    background: var(--p-grey-100);
    filter: saturate(0.9);
  }
  .h-member h3 { margin: 16px 0 2px; font-size: 1.02rem; }
  .h-member p { margin: 0; font-size: 13px; color: var(--p-grey-500); }

  /* ---------- Ecosystem ---------- */
  .h-eco { background: #fff; }
  .h-eco-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .h-eco-card {
    padding: 34px 32px 36px;
    border: 1px solid var(--p-grey-100);
    border-radius: 12px;
    background: var(--p-paper);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .h-eco-card h3 { font-size: 1.3rem; margin-bottom: 12px; }
  .h-eco-card p { color: var(--p-grey-500); flex: 1; }
  .h-eco-card .btn { margin-top: 22px; }
  .btn-ghost-dark { background: transparent; color: var(--p-deep); border: 1px solid var(--p-grey-300); }
  .btn-ghost-dark:hover { border-color: var(--p-deep); background: var(--p-tint); color: var(--p-deep); }

  @media (max-width: 1040px) {
    .h-team-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .h-pillar-grid,
    .h-eco-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .h-team-grid { grid-template-columns: repeat(2, 1fr); }
    .section { padding-block: 64px; }
  }
</style>
