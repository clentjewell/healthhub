---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import Icon from '@components/Icon.astro';
import { getSettings, getPage, mapEmbedSrc } from '../lib/content';
import { site } from '@data/site';

const cfg = await getSettings();
const page = await getPage('contact');
const mapSrc = mapEmbedSrc(cfg);

const socials = [
  cfg.facebook && { name: 'facebook' as const, label: 'Facebook', href: cfg.facebook },
  cfg.instagram && { name: 'instagram' as const, label: 'Instagram', href: cfg.instagram },
].filter(Boolean) as { name: 'facebook' | 'instagram'; label: string; href: string }[];
---

<BaseLayout fullTitle={page.metaTitle} description={page.metaDescription}>
  <PageHeader eyebrow={page.eyebrow} title={page.heading!} lede={page.lede} />

  <section class="section">
    <div class="container contact-grid">
      {/* Form */}
      <div class="contact-form-wrap">
        <h2>{page.formHeading}</h2>
        <form
          class="contact-form"
          method="POST"
          action={cfg.contactFormEndpoint || '#'}
          data-endpoint-set={cfg.contactFormEndpoint ? 'true' : 'false'}
        >
          {/* FormSubmit control fields. Harmless extras if the endpoint is ever
              something else — they just post as unused fields. `_next` is
              filled in by the script below so it follows whatever domain the
              site is on; without JS, FormSubmit's own thank-you page shows. */}
          <input type="hidden" name="_subject" value="New enquiry — Health Hub Tweed Coast website" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value="" />
          {/* Honeypot: humans never see it; bots that fill it are discarded. */}
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field" />
          <p class="form-sent" hidden>
            Thanks — your message has been sent. We'll get back to you soon.
          </p>
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="phone">Phone (optional)</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">{page.submitLabel}</button>
          {
            !cfg.contactFormEndpoint && (
              <p class="todo-note">
                Form endpoint not configured — set <strong>Contact form endpoint</strong>
                in the CMS under Settings.
              </p>
            )
          }
        </form>
      </div>

      {/* Details */}
      <aside class="contact-details">
        <h2 class="visually-hidden">Visit us</h2>
        <div class="detail">
          <h3>Visit</h3>
          <address>
            {cfg.street}<br />
            {cfg.locality} {cfg.region} {cfg.postcode}
          </address>
          <a href={cfg.mapUrl} target="_blank" rel="noopener">Get directions →</a>
        </div>
        <div class="detail">
          <h3>Open</h3>
          <p>{cfg.hoursLabel}</p>
        </div>
        {
          (cfg.phone || cfg.email) && (
            <div class="detail">
              <h3>Contact</h3>
              {cfg.phone && <p><a href={`tel:${cfg.phone.replace(/\s/g, '')}`}>{cfg.phone}</a></p>}
              {cfg.email && <p><a href={`mailto:${cfg.email}`}>{cfg.email}</a></p>}
            </div>
          )
        }
        {
          socials.length > 0 && (
            <div class="detail">
              <h3>Follow</h3>
              <ul class="contact-social" aria-label={`${site.name} on social media`}>
                {socials.map((so) => (
                  <li>
                    <a href={so.href} target="_blank" rel="noopener" aria-label={so.label} title={so.label}>
                      <Icon name={so.name} size={18} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    {page.showMap !== false && <div class="container map-wrap">
      <iframe
        title="Map to Health Hub Tweed Coast"
        src={mapSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>}
  </section>
</BaseLayout>

<script>
  // Send FormSubmit back to this page with ?sent=1, whichever domain we're on,
  // and show the confirmation when we arrive back with it.
  const next = document.querySelector<HTMLInputElement>('input[name="_next"]');
  if (next) next.value = `${location.origin}/contact/?sent=1`;

  if (new URLSearchParams(location.search).has('sent')) {
    const note = document.querySelector<HTMLElement>('.form-sent');
    if (note) note.hidden = false;
    note?.scrollIntoView({ block: 'center' });
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .contact-form { display: flex; flex-direction: column; gap: 18px; margin-top: 20px; max-width: none; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 13px; font-weight: 600; }
  .field input,
  .field textarea {
    font: inherit;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .field input:focus,
  .field textarea:focus { outline: 2px solid var(--color-brand); outline-offset: 1px; }
  .contact-form .btn { align-self: flex-start; }

  .contact-details { display: flex; flex-direction: column; gap: 28px; }
  .detail h3 { font-size: 0.95rem; margin-bottom: 8px; }
  .detail address { font-style: normal; line-height: 1.6; }
  .detail p { margin: 0; }
  /* Icon buttons, matching the footer and the practitioner profiles. */
  .contact-social { display: flex; gap: 10px; list-style: none; padding: 0; margin: 4px 0 0; }
  .contact-social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-brand);
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }
  .contact-social a:hover {
    background: var(--color-brand); color: #fff; border-color: var(--color-brand);
  }
  .contact-social svg { width: 18px; height: 18px; fill: currentColor; }
  .todo-note { font-size: 12px; color: var(--color-text-muted); font-style: italic; }
  .todo-note code { font-style: normal; }

  /* Honeypot: off-screen rather than display:none, so naive bots still fill it. */
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .form-sent {
    margin: 0 0 18px;
    padding: 12px 16px;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: var(--color-surface-tint);
    font-size: 15px;
  }

  .map-wrap { margin-top: 56px; }
  .map-wrap iframe {
    width: 100%;
    height: 400px;
    border: 0;
    border-radius: var(--radius-md);
    filter: grayscale(0.1);
  }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
