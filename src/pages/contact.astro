---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { nap, hours, social, contact, fullAddress } from '@data/site';

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(contact.mapEmbedQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
---

<BaseLayout
  title="Contact"
  description={`Contact Health Hub Tweed Coast — ${fullAddress}. Open ${hours.label}.`}
>
  <PageHeader
    eyebrow="Say hello"
    title="Contact"
    lede="Questions, bookings or class enquiries — we'd love to hear from you."
  />

  <section class="section">
    <div class="container contact-grid">
      {/* Form */}
      <div class="contact-form-wrap">
        <h2>Send a message</h2>
        <form
          class="contact-form"
          method="POST"
          action={contact.formEndpoint || '#'}
          data-endpoint-set={contact.formEndpoint ? 'true' : 'false'}
        >
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="phone">Phone (optional)</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Send message</button>
          {
            !contact.formEndpoint && (
              <p class="todo-note">
                Form endpoint not configured — set <code>contact.formEndpoint</code> in
                <code>site.ts</code> (TODO).
              </p>
            )
          }
        </form>
      </div>

      {/* Details */}
      <aside class="contact-details">
        <h2 class="visually-hidden">Visit us</h2>
        <div class="detail">
          <h3>Visit</h3>
          <address>
            {nap.street}<br />
            {nap.locality} {nap.region} {nap.postcode}
          </address>
          <a href={nap.mapUrl} target="_blank" rel="noopener">Get directions →</a>
        </div>
        <div class="detail">
          <h3>Open</h3>
          <p>{hours.label}</p>
        </div>
        <div class="detail">
          <h3>Follow</h3>
          <p>
            {social.instagram
              ? <a href={social.instagram} target="_blank" rel="noopener">Instagram {social.handle}</a>
              : social.handle}
          </p>
          {nap.phone && <p><a href={`tel:${nap.phone.replace(/\s/g, '')}`}>{nap.phone}</a></p>}
          {nap.email && <p><a href={`mailto:${nap.email}`}>{nap.email}</a></p>}
          {(!nap.phone || !nap.email) && <p class="todo-note">Phone / email — TODO (Phase 3).</p>}
        </div>
      </aside>
    </div>

    <div class="container map-wrap">
      <iframe
        title="Map to Health Hub Tweed Coast"
        src={mapSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .contact-form { display: flex; flex-direction: column; gap: 18px; margin-top: 20px; max-width: none; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 13px; font-weight: 600; }
  .field input,
  .field textarea {
    font: inherit;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .field input:focus,
  .field textarea:focus { outline: 2px solid var(--color-brand); outline-offset: 1px; }
  .contact-form .btn { align-self: flex-start; }

  .contact-details { display: flex; flex-direction: column; gap: 28px; }
  .detail h3 { font-size: 0.95rem; margin-bottom: 8px; }
  .detail address { font-style: normal; line-height: 1.6; }
  .detail p { margin: 0; }
  .todo-note { font-size: 12px; color: var(--color-text-muted); font-style: italic; }
  .todo-note code { font-style: normal; }

  .map-wrap { margin-top: 56px; }
  .map-wrap iframe {
    width: 100%;
    height: 400px;
    border: 0;
    border-radius: var(--radius-md);
    filter: grayscale(0.1);
  }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
