---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import PractitionerCard from '@components/PractitionerCard.astro';
import CtaBand from '@components/CtaBand.astro';
import { getPage } from '../../lib/content';

const page = await getPage('practitioners');

const practitioners = (await getCollection('practitioners')).sort(
  (a, b) => a.data.order - b.data.order,
);

/** First meaningful sentence of a bio, for the card excerpt. */
function excerpt(body: string | undefined, max = 120): string {
  if (!body) return '';
  const line = body
    .split('\n')
    .map((l) => l.trim())
    .find((l) => l && !l.startsWith('#') && !l.startsWith('*') && !l.startsWith('>') && !l.startsWith('!'));
  if (!line) return '';
  const clean = line.replace(/\*\*/g, '').replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').replace(/[*_`]/g, '');
  if (clean.length <= max) return clean;
  return clean.slice(0, clean.lastIndexOf(' ', max)).trimEnd() + '…';
}

const cards = await Promise.all(
  practitioners.map(async (p) => {
    const svc = p.data.service ? await getEntry('services', p.data.service) : undefined;
    return {
      name: p.data.name,
      role: p.data.role,
      href: `/our-practitioner/${p.id}`,
      image: p.data.image,
      serviceTitle: svc?.data.shortTitle ?? svc?.data.title,
      excerpt: excerpt(p.body),
      placeholder: p.data.placeholder,
    };
  }),
);
---

<BaseLayout title={page.metaTitle} description={page.metaDescription}>
  <PageHeader eyebrow={page.eyebrow} title={page.heading!} lede={page.lede} />

  <section class="section">
    <div class="container">
      <div class="grid-practitioners">
        {cards.map((c) => <PractitionerCard {...c} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .grid-practitioners {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  @media (max-width: 1040px) { .grid-practitioners { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px) { .grid-practitioners { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .grid-practitioners { grid-template-columns: 1fr; } }
</style>
