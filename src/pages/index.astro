---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import PractitionerCarousel from '@components/PractitionerCarousel.astro';
import EventCard from '@components/EventCard.astro';
import CtaBand from '@components/CtaBand.astro';
import { getSettings, getPage, mapEmbedSrc } from '../lib/content';

const cfg = await getSettings();
const page = await getPage('home');
const hero = page.hero!;
const welcome = page.welcome!;
const pracSec = page.practitioners!;
const eventsSec = page.events!;
const loc = page.location!;

const practitioners = (await getCollection('practitioners')).sort(
  (a, b) => a.data.order - b.data.order,
);

function excerpt(body: string | undefined, max = 110): string {
  if (!body) return '';
  const line = body
    .split('\n').map((l) => l.trim())
    .find((l) => l && !l.startsWith('#') && !l.startsWith('*') && !l.startsWith('>') && !l.startsWith('!'));
  if (!line) return '';
  const clean = line.replace(/\*\*/g, '').replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').replace(/[*_`]/g, '');
  return clean.length <= max ? clean : clean.slice(0, clean.lastIndexOf(' ', max)).trimEnd() + '…';
}

// All of them — the carousel scrolls, so there is no reason to hold any back.
const teaser = await Promise.all(
  practitioners.map(async (p) => {
    const svc = p.data.service ? await getEntry('services', p.data.service) : undefined;
    return {
      name: p.data.name, role: p.data.role, href: `/our-practitioner/${p.id}`,
      image: p.data.image, serviceTitle: svc?.data.shortTitle ?? svc?.data.title,
      excerpt: excerpt(p.body), placeholder: p.data.placeholder,
    };
  }),
);

// Four of the studio's offerings, in manual order.
const events = (await getCollection('events'))
  .filter((e) => e.data.active)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const mapSrc = mapEmbedSrc(cfg);
---

<BaseLayout title={page.metaTitle} description={page.metaDescription}>
  {/* Hero with background image slider */}
  <section class="hero">
    <div class="hero-slides" aria-hidden="true">
      <div class="hero-slide s1"></div>
      <div class="hero-slide s2"></div>
      <div class="hero-slide s3"></div>
    </div>
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        {hero.eyebrow && <p class="eyebrow hero-eyebrow">{hero.eyebrow}</p>}
        <h1>{hero.heading}</h1>
        {hero.lede && <p class="lede hero-lede">{hero.lede}</p>}
        <div class="hero-actions">
          {hero.primaryLabel && (
            <a href={hero.primaryHref ?? cfg.bookingHref} class="btn btn-primary">{hero.primaryLabel}</a>
          )}
          {hero.secondaryLabel && (
            <a href={hero.secondaryHref ?? '/events'} class="btn btn-hero-ghost">{hero.secondaryLabel}</a>
          )}
        </div>
      </div>
    </div>
  </section>

  {/* Welcome */}
  <section class="section welcome">
    <div class="narrow">
      <SectionHeading eyebrow={welcome.eyebrow} title={welcome.heading} align="center" />
      {welcome.paragraphs.map((p) => <p class="welcome-copy">{p}</p>)}
    </div>
  </section>

  {/* Practitioners teaser */}
  <section class="section band-tint">
    <div class="container">
      <SectionHeading eyebrow={pracSec.eyebrow} title={pracSec.heading} lede={pracSec.lede} />
    </div>
    {/* Outside .container: the track runs the full viewport width and scrolls
        off the right edge. Its own inset keeps the first card in line with the
        heading above. */}
    <PractitionerCarousel cards={teaser} label={pracSec.heading} />
    <div class="container">
      <p class="section-more">
        <a href="/our-practitioners" class="btn btn-ghost">{pracSec.linkLabel}</a>
      </p>
    </div>
  </section>

  {/* Events teaser — 4 of the studio's offerings */}
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow={eventsSec.eyebrow} title={eventsSec.heading} lede={eventsSec.lede} />
      <div class="grid-events">
        {
          events.map((e) => (
            <EventCard
              title={e.data.title} href={`/event/${e.id}`} category={e.data.category}
              summary={e.data.summary} schedule={e.data.schedule} image={e.data.image}
              price={e.data.price} instructor={e.data.instructor} featured={e.data.featured}
              layout="horizontal"
            />
          ))
        }
      </div>
      <p class="section-more">
        <a href="/events" class="btn btn-ghost">{eventsSec.linkLabel}</a>
      </p>
    </div>
  </section>

  {/* Find us — copy left, map right */}
  <section class="section location band-tint">
    <div class="container location-grid">
      <div class="location-copy">
        <SectionHeading eyebrow={loc.eyebrow} title={loc.heading} />
        <p class="location-nap">
          {cfg.street}<br />
          {cfg.locality} {cfg.region} {cfg.postcode}
        </p>
        <p class="location-hours"><strong>Open</strong> · {cfg.hoursLabel}</p>
        <div class="location-actions">
          <a href={cfg.mapUrl} target="_blank" rel="noopener" class="btn btn-primary">{loc.directionsLabel}</a>
          <a href="/contact" class="btn btn-ghost">{loc.contactLabel}</a>
        </div>
      </div>
      <div class="location-map">
        <iframe
          title="Map to Health Hub Tweed Coast"
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---- Hero + background slider ---- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(70vh, 620px);
    padding-block: clamp(80px, 14vw, 160px);
    color: #fff;
    overflow: hidden;
    background: var(--hub-navy, #22496c);
  }
  .hero-slides { position: absolute; inset: 0; }
  .hero-slide {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    opacity: 0;
    /* Crossfade + a very slow scale (Ken Burns) for depth. Transform/opacity
       only, so it stays off the layout/paint path. */
    animation: heroFade 21s infinite, heroDrift 21s infinite;
  }
  .hero-slide.s1 { background-image: url('/images/hero-1.webp'); animation-delay: 0s; }
  .hero-slide.s2 { background-image: url('/images/hero-2.webp'); animation-delay: 7s; }
  .hero-slide.s3 { background-image: url('/images/hero-3.webp'); animation-delay: 14s; }
  @keyframes heroFade {
    0% { opacity: 0; }
    4% { opacity: 1; }
    30% { opacity: 1; }
    36% { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes heroDrift {
    0%   { transform: scale(1.02); }
    36%  { transform: scale(1.08); }
    100% { transform: scale(1.08); }
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(
      100deg,
      rgba(34, 73, 108, 0.84) 0%,
      rgba(34, 73, 108, 0.58) 60%,
      rgba(46, 159, 164, 0.4) 100%
    );
  }
  /* Keep the container's width/padding so the hero text starts on the same
     vertical line as the logo in the header; constrain the copy separately. */
  /* `.hero` is a flex container, so the inner container must be told to fill
     the line — otherwise it shrinks to its content and auto-margins centre it. */
  .hero-inner { position: relative; z-index: 1; width: 100%; }
  .hero-copy { max-width: 720px; }
  .hero :global(h1) { color: #fff; }
  .hero-eyebrow { color: color-mix(in srgb, var(--color-accent) 55%, white); }
  .hero-lede { color: rgba(255, 255, 255, 0.92); margin-top: 20px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .btn-hero-ghost { background: transparent; color: #fff; border: 1px solid rgba(255, 255, 255, 0.6); }
  .btn-hero-ghost:hover { border-color: #fff; background: rgba(255, 255, 255, 0.12); color: #fff; }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide { animation: none; transform: none; }
    .hero-slide.s1 { opacity: 1; }
  }

  .welcome { padding-block: clamp(72px, 10vw, 128px); }
  .welcome-copy { text-align: center; max-width: 58ch; margin-inline: auto; font-size: var(--fs-lede); }
  /* A small gold mark from the logo's centre dot, used as a quiet section rule. */
  .welcome .narrow::after {
    content: '';
    display: block;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--hub-gold, #f2b01e);
    margin: 44px auto 0;
  }
  .band-tint { background: var(--color-surface-tint); }
  /* `max-width: none` overrides the global `p` clamp, otherwise the button
     centres inside a 68ch box rather than the full container. */
  .section-more {
    margin-top: 36px;
    max-width: none;
    display: flex;
    justify-content: center;
  }

  .grid-events { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }

  /* Staggered reveal — 60ms apart. Cards are visible by default so they still
     render without JS or with reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .grid-events > :global(*) {
      animation: riseIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .grid-events > :global(*:nth-child(1)) { animation-delay: 0ms; }
    .grid-events > :global(*:nth-child(2)) { animation-delay: 60ms; }
    .grid-events > :global(*:nth-child(3)) { animation-delay: 120ms; }
    .grid-events > :global(*:nth-child(4)) { animation-delay: 180ms; }
  }
  /* Animates the independent `translate` property, not `transform`: a filled
     animation beats a plain declaration, so animating `transform` here would
     permanently cancel each card's `transform` hover lift. */
  @keyframes riseIn {
    from { opacity: 0; translate: 0 14px; }
    to   { opacity: 1; translate: none; }
  }

  .location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .location-nap { font-size: var(--fs-lede); margin-bottom: 8px; }
  .location-hours { color: var(--color-text-muted); margin-bottom: 24px; }
  .location-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .location-map iframe {
    width: 100%; height: 380px; border: 0;
    border-radius: var(--radius-md); box-shadow: var(--shadow-md);
  }

  @media (max-width: 900px) { .grid-events { grid-template-columns: 1fr; } }
  @media (max-width: 860px) { .location-grid { grid-template-columns: 1fr; } }
</style>
