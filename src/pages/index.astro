---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import PractitionerCard from '@components/PractitionerCard.astro';
import EventCard from '@components/EventCard.astro';
import CtaBand from '@components/CtaBand.astro';
import { site, nap, hours, contact, bookingCta } from '@data/site';

const practitioners = (await getCollection('practitioners')).sort(
  (a, b) => a.data.order - b.data.order,
);

function excerpt(body: string | undefined, max = 110): string {
  if (!body) return '';
  const line = body
    .split('\n').map((l) => l.trim())
    .find((l) => l && !l.startsWith('#') && !l.startsWith('*') && !l.startsWith('>') && !l.startsWith('!'));
  if (!line) return '';
  const clean = line.replace(/\*\*/g, '').replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').replace(/[*_`]/g, '');
  return clean.length <= max ? clean : clean.slice(0, clean.lastIndexOf(' ', max)).trimEnd() + '…';
}

const teaser = await Promise.all(
  practitioners.slice(0, 4).map(async (p) => {
    const svc = p.data.service ? await getEntry('services', p.data.service) : undefined;
    return {
      name: p.data.name, role: p.data.role, href: `/practitioners/${p.id}`,
      image: p.data.image, serviceTitle: svc?.data.shortTitle ?? svc?.data.title,
      excerpt: excerpt(p.body), placeholder: p.data.placeholder,
    };
  }),
);

const now = new Date();
const events = (await getCollection('events'))
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 2);

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(contact.mapEmbedQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
---

<BaseLayout title="Home">
  {/* Hero with background image slider */}
  <section class="hero">
    <div class="hero-slides" aria-hidden="true">
      <div class="hero-slide s1"></div>
      <div class="hero-slide s2"></div>
      <div class="hero-slide s3"></div>
    </div>
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Wellness studio · Hastings Point</p>
        <h1>Body, Mind &amp; Soul</h1>
        <p class="lede hero-lede">
          {site.name} — the community wellness studio arm of Pottsville Acupuncture.
          Acupuncture and allied health, movement classes and events, all under one
          roof on the Tweed Coast.
        </p>
        <div class="hero-actions">
          <a href={bookingCta.href} class="btn btn-primary">{bookingCta.label}</a>
          <a href="/classes-events" class="btn btn-hero-ghost">See the timetable</a>
        </div>
      </div>
    </div>
  </section>

  {/* Welcome */}
  <section class="section welcome">
    <div class="narrow">
      <SectionHeading eyebrow="Welcome" title="Welcome to Health Hub Tweed Coast" align="center" />
      <p class="welcome-copy">
        We are a group of therapists, practitioners and teachers who have come together
        with the sole purpose to help you and your family heal and live full lives.
      </p>
      <p class="welcome-copy">
        Receive the care you deserve, delivered collaboratively from a group of dedicated
        and talented practitioners and therapists.
      </p>
    </div>
  </section>

  {/* Practitioners teaser */}
  <section class="section band-tint">
    <div class="container">
      <SectionHeading
        eyebrow="Meet the team"
        title="Our Practitioners"
        lede="A multidisciplinary team — each leading their own service, from acupuncture and naturopathy to yoga, pilates, movement and sound."
      />
      <div class="grid-practitioners">
        {teaser.map((c) => <PractitionerCard {...c} />)}
      </div>
      <p class="section-more">
        <a href="/practitioners" class="btn btn-ghost">Meet all our practitioners</a>
      </p>
    </div>
  </section>

  {/* Events teaser — 2 per row */}
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="On the calendar"
        title="Upcoming at the Hub"
        lede="A taste of what's coming up. See the full weekly timetable and events."
      />
      <div class="grid-events">
        {
          events.map((e) => (
            <EventCard
              title={e.data.title} date={e.data.date} category={e.data.category}
              summary={e.data.summary} image={e.data.image} location={e.data.location}
              price={e.data.price} bookingUrl={e.data.bookingUrl}
              featured={e.data.featured} placeholder={e.data.placeholder}
            />
          ))
        }
      </div>
      <p class="section-more">
        <a href="/classes-events" class="btn btn-ghost">View timetable &amp; events</a>
      </p>
    </div>
  </section>

  {/* Find us — copy left, map right */}
  <section class="section location band-tint">
    <div class="container location-grid">
      <div class="location-copy">
        <SectionHeading eyebrow="Find us" title="Hastings Point, on the Tweed Coast" />
        <p class="location-nap">
          {nap.street}<br />
          {nap.locality} {nap.region} {nap.postcode}
        </p>
        <p class="location-hours"><strong>Open</strong> · {hours.label}</p>
        <div class="location-actions">
          <a href={nap.mapUrl} target="_blank" rel="noopener" class="btn btn-primary">Get directions</a>
          <a href="/contact" class="btn btn-ghost">Contact us</a>
        </div>
      </div>
      <div class="location-map">
        <iframe
          title="Map to Health Hub Tweed Coast"
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---- Hero + background slider ---- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(70vh, 620px);
    padding-block: clamp(80px, 14vw, 160px);
    color: #fff;
    overflow: hidden;
    background: var(--hub-navy, #22496c);
  }
  .hero-slides { position: absolute; inset: 0; }
  .hero-slide {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    opacity: 0;
    animation: heroFade 21s infinite;
  }
  .hero-slide.s1 { background-image: url('/images/hero-1.webp'); animation-delay: 0s; }
  .hero-slide.s2 { background-image: url('/images/hero-2.webp'); animation-delay: 7s; }
  .hero-slide.s3 { background-image: url('/images/hero-3.webp'); animation-delay: 14s; }
  @keyframes heroFade {
    0% { opacity: 0; }
    4% { opacity: 1; }
    30% { opacity: 1; }
    36% { opacity: 0; }
    100% { opacity: 0; }
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(
      100deg,
      rgba(34, 73, 108, 0.84) 0%,
      rgba(34, 73, 108, 0.58) 60%,
      rgba(46, 159, 164, 0.4) 100%
    );
  }
  /* Keep the container's width/padding so the hero text starts on the same
     vertical line as the logo in the header; constrain the copy separately. */
  /* `.hero` is a flex container, so the inner container must be told to fill
     the line — otherwise it shrinks to its content and auto-margins centre it. */
  .hero-inner { position: relative; z-index: 1; width: 100%; }
  .hero-copy { max-width: 720px; }
  .hero :global(h1) { color: #fff; }
  .hero-eyebrow { color: color-mix(in srgb, var(--color-accent) 55%, white); }
  .hero-lede { color: rgba(255, 255, 255, 0.92); margin-top: 20px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .btn-hero-ghost { background: transparent; color: #fff; border: 1px solid rgba(255, 255, 255, 0.6); }
  .btn-hero-ghost:hover { border-color: #fff; background: rgba(255, 255, 255, 0.12); color: #fff; }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide { animation: none; }
    .hero-slide.s1 { opacity: 1; }
  }

  .welcome-copy { text-align: center; max-width: 62ch; margin-inline: auto; font-size: var(--fs-lede); }
  .band-tint { background: var(--color-surface-tint); }
  /* `max-width: none` overrides the global `p` clamp, otherwise the button
     centres inside a 68ch box rather than the full container. */
  .section-more {
    margin-top: 36px;
    max-width: none;
    display: flex;
    justify-content: center;
  }

  .grid-practitioners { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }

  .grid-events { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }

  .location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .location-nap { font-size: var(--fs-lede); margin-bottom: 8px; }
  .location-hours { color: var(--color-text-muted); margin-bottom: 24px; }
  .location-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .location-map iframe {
    width: 100%; height: 380px; border: 0;
    border-radius: var(--radius-md); box-shadow: var(--shadow-md);
  }

  @media (max-width: 1040px) { .grid-practitioners { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 860px) {
    .location-grid { grid-template-columns: 1fr; }
    .grid-events { grid-template-columns: 1fr; }
  }
  @media (max-width: 460px) { .grid-practitioners { grid-template-columns: 1fr; } }
</style>
