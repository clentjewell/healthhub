---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ServiceCard from '@components/ServiceCard.astro';
import EventCard from '@components/EventCard.astro';
import CtaBand from '@components/CtaBand.astro';
import PlaceholderImage from '@components/PlaceholderImage.astro';
import { site, nap, hours, bookingCta } from '@data/site';

const services = (await getCollection('services'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const now = new Date();
const events = (await getCollection('events'))
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home">
  {/* Full-bleed hero with image */}
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">Wellness studio · Hastings Point</p>
      <h1>Body, Mind &amp; Soul</h1>
      <p class="lede hero-lede">
        {site.name} — the community wellness studio arm of Pottsville Acupuncture.
        Acupuncture and allied health, movement classes and events, all under one
        roof on the Tweed Coast.
      </p>
      <div class="hero-actions">
        <a href={bookingCta.href} class="btn btn-primary">{bookingCta.label}</a>
        <a href="/classes-events" class="btn btn-hero-ghost">See the timetable</a>
      </div>
    </div>
  </section>

  {/* Welcome */}
  <section class="section welcome">
    <div class="narrow">
      <SectionHeading eyebrow="Welcome" title="Welcome to Health Hub Tweed Coast" align="center" />
      <p class="welcome-copy">
        We are a group of therapists, practitioners and teachers who have come together
        with the sole purpose to help you and your family heal and live full lives.
      </p>
      <p class="welcome-copy">
        Receive the care you deserve, delivered collaboratively from a group of dedicated
        and talented practitioners and therapists.
      </p>
    </div>
  </section>

  {/* Our Services (with images) — each links through to the practitioner who offers it */}
  <section class="section band-tint">
    <div class="container">
      <SectionHeading
        eyebrow="What we offer"
        title="Our Services"
        lede="Each service is led by a dedicated practitioner or teacher."
      />
      <div class="grid-services">
        {
          services.map((s) => (
            <ServiceCard
              title={s.data.shortTitle ?? s.data.title}
              summary={s.data.summary}
              href={s.data.provider ? `/practitioners/${s.data.provider}` : `/services/${s.id}`}
              icon={s.data.icon}
              image={s.data.image}
              placeholder={s.data.placeholder}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* Events teaser */}
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="On the calendar"
        title="Upcoming at the Hub"
        lede="A taste of what's coming up. See the full weekly timetable and events."
      />
      <div class="grid-events">
        {
          events.map((e) => (
            <EventCard
              title={e.data.title}
              date={e.data.date}
              category={e.data.category}
              summary={e.data.summary}
              image={e.data.image}
              location={e.data.location}
              price={e.data.price}
              bookingUrl={e.data.bookingUrl}
              featured={e.data.featured}
              placeholder={e.data.placeholder}
            />
          ))
        }
      </div>
      <p class="section-more">
        <a href="/classes-events" class="btn btn-ghost">View timetable &amp; events</a>
      </p>
    </div>
  </section>

  {/* Location */}
  <section class="section location band-tint">
    <div class="container location-grid">
      <div>
        <SectionHeading eyebrow="Find us" title="Hastings Point, on the Tweed Coast" />
        <p class="location-nap">
          {nap.street}<br />
          {nap.locality} {nap.region} {nap.postcode}
        </p>
        <p class="location-hours"><strong>Open</strong> · {hours.label}</p>
        <a href="/contact" class="btn btn-ghost">Contact &amp; directions</a>
      </div>
      <PlaceholderImage label="Map / studio image" ratio="4/3" icon="📍" />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(70vh, 620px);
    padding-block: clamp(80px, 14vw, 160px);
    background: url('/images/hero.webp') center/cover no-repeat;
    color: #fff;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(34, 73, 108, 0.82) 0%,
      rgba(34, 73, 108, 0.55) 60%,
      rgba(46, 159, 164, 0.35) 100%
    );
  }
  .hero-inner { position: relative; z-index: 1; max-width: 720px; }
  .hero :global(h1) { color: #fff; }
  .hero-eyebrow { color: color-mix(in srgb, var(--color-accent) 55%, white); }
  .hero-lede { color: rgba(255, 255, 255, 0.92); margin-top: 20px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .btn-hero-ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.6);
  }
  .btn-hero-ghost:hover { border-color: #fff; background: rgba(255, 255, 255, 0.12); color: #fff; }

  .welcome-copy { text-align: center; max-width: 62ch; margin-inline: auto; font-size: var(--fs-lede); }
  .band-tint { background: var(--color-surface-tint); }

  .grid-services { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .grid-events { grid-template-columns: 1fr; gap: 16px; max-width: 820px; display: grid; }
  .section-more { margin-top: 36px; text-align: center; }

  .location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .location-nap { font-size: var(--fs-lede); margin-bottom: 8px; }
  .location-hours { color: var(--color-text-muted); margin-bottom: 24px; }

  @media (max-width: 980px) { .grid-services { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 860px) { .location-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .grid-services { grid-template-columns: 1fr; } }
</style>
