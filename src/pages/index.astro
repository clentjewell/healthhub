---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ServiceCard from '@components/ServiceCard.astro';
import PractitionerCard from '@components/PractitionerCard.astro';
import EventCard from '@components/EventCard.astro';
import CtaBand from '@components/CtaBand.astro';
import PlaceholderImage from '@components/PlaceholderImage.astro';
import { site, nap, hours, bookingCta } from '@data/site';

const services = (await getCollection('services'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const practitioners = (await getCollection('practitioners')).sort(
  (a, b) => a.data.order - b.data.order,
);

const now = new Date();
const events = (await getCollection('events'))
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home">
  {/* Hero */}
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Wellness studio · Hastings Point</p>
        <h1>A calm home for movement, treatment &amp; community</h1>
        <p class="lede">
          {site.name} is the community studio arm of Pottsville Acupuncture —
          acupuncture and allied health, movement classes, and events, all under
          one roof on the Tweed Coast.
        </p>
        <div class="hero-actions">
          <a href={bookingCta.href} class="btn btn-primary">{bookingCta.label}</a>
          <a href="/classes-events" class="btn btn-ghost">See the timetable</a>
        </div>
      </div>
      <div class="hero-media">
        <PlaceholderImage label="Hero image" ratio="4/5" icon="🌊" />
      </div>
    </div>
  </section>

  {/* Services */}
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="What we offer"
        title="Services"
        lede="Treatments and classes to support your wellbeing — explore each below."
      />
      <div class="grid grid-services">
        {
          services.map((s) => (
            <ServiceCard
              title={s.data.shortTitle ?? s.data.title}
              summary={s.data.summary}
              href={`/services/${s.id}`}
              icon={s.data.icon}
              placeholder={s.data.placeholder}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* Classes & events teaser */}
  <section class="section band-tint">
    <div class="container">
      <SectionHeading
        eyebrow="On the calendar"
        title="Upcoming at the Hub"
        lede="A taste of what's coming up. See the full weekly timetable and events."
      />
      <div class="grid grid-events">
        {
          events.map((e) => (
            <EventCard
              title={e.data.title}
              date={e.data.date}
              category={e.data.category}
              summary={e.data.summary}
              location={e.data.location}
              price={e.data.price}
              bookingUrl={e.data.bookingUrl}
              featured={e.data.featured}
              placeholder={e.data.placeholder}
            />
          ))
        }
      </div>
      <p class="section-more">
        <a href="/classes-events" class="btn btn-ghost">View timetable &amp; events</a>
      </p>
    </div>
  </section>

  {/* Practitioners teaser */}
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Meet the team"
        title="Our practitioners"
        lede="A multidisciplinary team of practitioners and teachers."
      />
      <div class="grid grid-practitioners">
        {
          practitioners.slice(0, 4).map((p) => (
            <PractitionerCard
              name={p.data.name}
              role={p.data.role}
              href={`/practitioners/${p.id}`}
              image={p.data.image}
              modalities={p.data.modalities}
              placeholder={p.data.placeholder}
            />
          ))
        }
      </div>
      <p class="section-more">
        <a href="/practitioners" class="btn btn-ghost">Meet the whole team</a>
      </p>
    </div>
  </section>

  {/* Location */}
  <section class="section location">
    <div class="container location-grid">
      <div>
        <SectionHeading eyebrow="Find us" title="Hastings Point, on the Tweed Coast" />
        <p class="location-nap">
          {nap.street}<br />
          {nap.locality} {nap.region} {nap.postcode}
        </p>
        <p class="location-hours"><strong>Open</strong> · {hours.label}</p>
        <a href="/contact" class="btn btn-ghost">Contact &amp; directions</a>
      </div>
      <PlaceholderImage label="Map / studio image" ratio="4/3" icon="📍" />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero { padding-block: clamp(48px, 8vw, 96px); }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .hero-media { max-width: 420px; width: 100%; margin-inline: auto; }

  .grid { display: grid; gap: 24px; }
  .grid-services { grid-template-columns: repeat(4, 1fr); }
  .grid-events { grid-template-columns: 1fr; gap: 16px; max-width: 820px; }
  .grid-practitioners { grid-template-columns: repeat(4, 1fr); }

  .band-tint { background: var(--color-surface-tint); }
  .section-more { margin-top: 36px; text-align: center; }

  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .location-nap { font-size: var(--fs-lede); margin-bottom: 8px; }
  .location-hours { color: var(--color-text-muted); margin-bottom: 24px; }

  @media (max-width: 980px) {
    .grid-services,
    .grid-practitioners { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-media { order: -1; max-width: 320px; }
    .location-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 540px) {
    .grid-services,
    .grid-practitioners { grid-template-columns: 1fr; }
  }
</style>
