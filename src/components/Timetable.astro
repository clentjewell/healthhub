---
/**
 * The weekly studio timetable, as a real table.
 *
 * Seven day columns with the sessions stacked inside each, mirroring the live
 * site's grid. Below it, the contact row — read from the practitioners
 * collection rather than duplicated here, so a phone number is only ever
 * changed in one place.
 */
import { getCollection, getEntry } from 'astro:content';

const entry = await getEntry('timetable', 'weekly');
if (!entry) throw new Error('Missing src/content/timetable/weekly.yml');
const { days, note } = entry.data;

const practitioners = (await getCollection('practitioners'))
  .filter((p) => p.data.active && p.data.phone)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="tt">
  <h2 class="tt-h">Weekly Timetable</h2>

  <div class="tt-scroll" tabindex="0" role="group" aria-labelledby="tt-cap">
    <table class="tt-table">
      <caption id="tt-cap" class="tt-cap">
        Classes and consultations by day.
        <span class="tt-cap-scroll">Scroll sideways to see the full week.</span>
      </caption>
      <thead>
        <tr>
          {days.map((d) => <th scope="col">{d.day}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr>
          {
            days.map((d) => (
              <td>
                {d.sessions.length === 0 ? (
                  <span class="tt-empty">—</span>
                ) : (
                  <ul class="tt-list">
                    {d.sessions.map((s) => (
                      <li class="tt-item">
                        {s.href ? (
                          <a href={s.href}>
                            <span class="tt-name">{s.name}</span>
                            <span class="tt-time">{s.time}</span>
                          </a>
                        ) : (
                          <>
                            <span class="tt-name">{s.name}</span>
                            <span class="tt-time">{s.time}</span>
                          </>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </td>
            ))
          }
        </tr>
      </tbody>
    </table>
  </div>

  {note && <p class="tt-note">{note}</p>}

  <h3 class="tt-contacts-h">Who to contact</h3>
  <ul class="tt-contacts">
    {
      practitioners.map((p) => (
        <li>
          <a href={`/our-practitioner/${p.id}`}>
            <span class="tt-c-role">{p.data.role}</span>
            <span class="tt-c-name">{p.data.name}</span>
          </a>
          <a class="tt-c-phone" href={`tel:${p.data.phone!.replace(/[^\d+]/g, '')}`}>
            {p.data.phone}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .tt { min-width: 0; }
  .tt-h { font-size: 1.5rem; margin-bottom: 18px; }

  /* Seven columns need horizontal room on a phone; the table keeps its
     semantics and scrolls inside its own box rather than the page. */
  .tt-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    -webkit-overflow-scrolling: touch;
  }
  .tt-scroll:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* Fixed layout keeps the seven days equal, so a busy Wednesday doesn't
     squeeze the quiet days into slivers. */
  .tt-table {
    width: 100%; min-width: 900px; table-layout: fixed;
    border-collapse: collapse; font-size: 14px;
  }
  .tt-cap {
    caption-side: top; text-align: left;
    padding: 14px 16px 0; font-size: 12px; color: var(--color-text-muted);
  }
  /* The whole week fits without scrolling once the container is wide enough. */
  @media (min-width: 1040px) {
    .tt-cap-scroll { display: none; }
  }
  .tt-table th {
    text-align: left; padding: 14px 16px;
    font-family: var(--font-sans); font-size: 11px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-brand); background: var(--color-surface-tint);
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }
  .tt-table td {
    vertical-align: top; padding: 14px 12px;
    border-left: 1px solid var(--color-surface-tint);
  }
  .tt-table td:first-child { border-left: none; }
  .tt-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .tt-item > a,
  .tt-item {
    display: block;
    border-radius: 8px;
  }
  .tt-item > a { padding: 8px 10px; margin: -8px -10px; color: inherit; transition: background var(--transition); }
  .tt-item > a:hover { background: var(--color-surface-tint); }
  .tt-item > a:hover .tt-name { color: var(--color-brand); }
  .tt-name {
    display: block; font-weight: 600; color: var(--color-heading);
    line-height: 1.35; margin-bottom: 3px;
  }
  .tt-time {
    display: block; font-size: 13px; color: var(--color-accent);
    font-weight: 600; font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tt-empty { color: var(--color-text-muted); }

  .tt-note { margin-top: 14px; font-size: 13px; color: var(--color-text-muted); max-width: 66ch; }

  .tt-contacts-h { font-size: 1.1rem; margin: 36px 0 14px; }
  .tt-contacts {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px;
  }
  .tt-contacts li {
    display: flex; justify-content: space-between; align-items: center; gap: 14px;
    padding: 12px 16px;
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .tt-c-role {
    display: block; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-text-muted); font-weight: 600; margin-bottom: 2px;
  }
  .tt-c-name { display: block; font-weight: 600; color: var(--color-heading); }
  .tt-contacts li > a:first-child:hover .tt-c-name { color: var(--color-brand); }
  .tt-c-phone {
    font-size: 14px; font-weight: 600; color: var(--color-brand);
    white-space: nowrap; font-variant-numeric: tabular-nums;
    display: inline-flex; align-items: center; min-height: 44px;
  }
</style>
