---
import PlaceholderImage from './PlaceholderImage.astro';
interface Props {
  name: string;
  role: string;
  href: string;
  image?: string;
  serviceTitle?: string;
  excerpt?: string;
  placeholder?: boolean;
}
const { name, role, href, image, serviceTitle, excerpt, placeholder } = Astro.props;
---

<a class="pcard" href={href}>
  <div class="pcard-media">
    {
      image ? (
        <img src={image} alt={`Portrait of ${name}`} loading="lazy" width="320" height="400" />
      ) : (
        <PlaceholderImage label="Portrait" ratio="4/5" icon="user" />
      )
    }
    {serviceTitle && <span class="pcard-svc">{serviceTitle}</span>}
    {placeholder && import.meta.env.DEV && <span class="ph-badge">Placeholder</span>}
  </div>
  <div class="pcard-body">
    <h3>{name}</h3>
    <p class="pcard-role">{role}</p>
    {excerpt && <p class="pcard-excerpt">{excerpt}</p>}
    <span class="pcard-link">View profile →</span>
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    color: var(--color-text);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .pcard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
  }
  .pcard-media { position: relative; aspect-ratio: 4/5; overflow: hidden; }
  .pcard-media img {
    width: 100%; height: 100%; object-fit: cover; object-position: top;
    /* The source portraits vary a lot in tone (studio, beach, gym). A slight
       desaturation evens them out; hover restores full colour. */
    filter: saturate(0.88) contrast(1.02);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
  }
  .pcard:hover .pcard-media img { transform: scale(1.04); filter: saturate(1) contrast(1); }
  /* Scrim so the service chip stays legible over any photo. */
  .pcard-media::after {
    content: '';
    position: absolute; inset: auto 0 0 0; height: 45%;
    background: linear-gradient(to top, rgba(34, 73, 108, 0.55), transparent);
    pointer-events: none;
  }
  .pcard-svc {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    background: rgba(34, 73, 108, 0.86);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 5px 12px;
    border-radius: 999px;
  }
  .ph-badge {
    position: absolute; top: 12px; right: 12px;
    font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
    background: rgba(255, 255, 255, 0.92); color: var(--color-text-muted);
    padding: 3px 7px; border-radius: 999px;
  }
  .pcard-body { display: flex; flex-direction: column; flex: 1; padding: 20px 22px 22px; }
  .pcard-body h3 { font-size: 1.15rem; margin-bottom: 3px; }
  .pcard:hover h3 { color: var(--color-brand); }
  .pcard-role {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-accent);
    margin: 0 0 12px;
    text-transform: none;
  }
  .pcard-excerpt {
    font-size: 13.5px;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0 0 18px;
    flex: 1;
  }
  .pcard-link { font-size: 13px; font-weight: 600; color: var(--color-brand); margin-top: auto; }
</style>
