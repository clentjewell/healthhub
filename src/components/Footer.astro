---
/**
 * Site footer — carries the canonical NAP block plus navigation and social.
 * All of it is CMS-editable via the `settings` collection; the LocalBusiness
 * JSON-LD (Phase 5) reads from that same source.
 */
import { getSettings, formatAddress } from '../lib/content';
import Icon from './Icon.astro';

const s = await getSettings();
const nav = s.navItems;
const bookingCta = { label: s.bookingLabel, href: s.bookingHref };
const fullAddress = formatAddress(s);
const year = new Date().getFullYear();
const siteName = `${s.brandName} ${s.brandTagline}`;

const socials = [
  s.facebook && { name: 'facebook' as const, label: 'Facebook', href: s.facebook },
  s.instagram && { name: 'instagram' as const, label: 'Instagram', href: s.instagram },
].filter(Boolean) as { name: 'facebook' | 'instagram'; label: string; href: string }[];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label={`${siteName} — home`}>
        <img src="/images/logo.png" alt={siteName} width="240" height="54" loading="lazy" />
      </a>
      <p class="footer-blurb">{s.footerBlurb}</p>
    </div>

    <div class="footer-col">
      <h2 class="footer-h">Visit</h2>
      <address class="nap">
        <span>{s.street}</span>
        <span>{s.locality} {s.region} {s.postcode}</span>
        <a href={s.mapUrl} target="_blank" rel="noopener">Get directions</a>
      </address>
      <p class="hours"><strong>Open</strong><br />{s.hoursLabel}</p>
    </div>

    <div class="footer-col">
      <h2 class="footer-h">Explore</h2>
      <ul class="footer-nav">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={bookingCta.href}>{bookingCta.label}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2 class="footer-h">Connect</h2>
      <ul class="footer-nav">
        {s.phone && <li><a href={`tel:${s.phone.replace(/\s/g, '')}`}>{s.phone}</a></li>}
        {s.email && <li><a href={`mailto:${s.email}`}>{s.email}</a></li>}
      </ul>
      {
        socials.length > 0 && (
          <ul class="footer-social" aria-label={`${siteName} on social media`}>
            {socials.map((so) => (
              <li>
                <a href={so.href} target="_blank" rel="noopener" aria-label={so.label} title={so.label}>
                  <Icon name={so.name} size={18} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="container footer-base">
    <p>&copy; {year} {s.brandName} {s.brandTagline}. {fullAddress}.</p>
    {s.footerNote && <p class="footer-fine">{s.footerNote}</p>}
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-band);
    color: var(--color-band-text);
    padding-block: 64px 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
  }
  /* The official logo is dark-on-transparent, so on the navy footer it sits on
     a light plate rather than being recoloured (no unofficial white variant). */
  .footer-logo {
    display: inline-block;
    background: #fff;
    border-radius: var(--radius-md);
    padding: 12px 16px;
  }
  .footer-logo img { height: 40px; width: auto; display: block; }
  .footer-blurb {
    margin-top: 20px;
    font-size: 14px;
    opacity: 0.8;
    max-width: 34ch;
  }
  .footer-h {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0.7;
    margin: 0 0 16px;
  }
  .nap {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
    line-height: 1.5;
  }
  .nap a,
  .footer-nav a {
    color: #fff;
    opacity: 0.85;
  }
  .nap a:hover,
  .footer-nav a:hover {
    opacity: 1;
    color: #fff;
    text-decoration: underline;
  }
  .nap a {
    margin-top: 8px;
    opacity: 0.75;
  }
  .hours {
    font-size: 14px;
    margin-top: 16px;
    opacity: 0.85;
  }
  .footer-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
  }
  .footer-social { display: flex; gap: 10px; list-style: none; padding: 0; margin: 16px 0 0; }
  .footer-social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: #fff; opacity: 0.9;
    transition: background var(--transition), border-color var(--transition), opacity var(--transition);
  }
  .footer-social a:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.6);
    opacity: 1;
  }

  .footer-base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 12px;
    opacity: 0.7;
  }
  .footer-base p {
    margin: 0;
    max-width: none;
  }

  @media (max-width: 880px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 540px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
