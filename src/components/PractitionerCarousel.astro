---
/**
 * Homepage practitioners carousel.
 *
 * Cards show the portrait only; hovering (or focusing) shrinks the image and
 * slides the details up from underneath. The reveal is a height transition on
 * the image with the body sitting below it in normal flow, so nothing is
 * absolutely positioned and the card can never reveal a clipped half-line.
 *
 * The track is a native scroll-snap container: it scrolls by touch, trackpad
 * and keyboard with no JavaScript at all. The arrows are an enhancement — they
 * are hidden until the script confirms the content actually overflows.
 */
import PlaceholderImage from './PlaceholderImage.astro';

export interface CarouselCard {
  name: string;
  role: string;
  href: string;
  image?: string;
  serviceTitle?: string;
  excerpt?: string;
  placeholder?: boolean;
}
interface Props {
  cards: CarouselCard[];
  /** Accessible name for the scroll region. */
  label?: string;
}
const { cards, label = 'Our practitioners' } = Astro.props;
---

<div class="pcar" data-pcar>
  <button type="button" class="pcar-nav pcar-prev" aria-label="Show previous practitioners" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4l-8 8 8 8" /></svg>
  </button>

  <ul class="pcar-track" role="list" aria-label={label} data-pcar-track>
    {
      cards.map((c) => (
        <li class="pcar-item">
          <a class="pcard-r" href={c.href}>
            <div class="pcard-r-media">
              {
                c.image ? (
                  <img src={c.image} alt={`Portrait of ${c.name}`} loading="lazy" width="320" height="440" />
                ) : (
                  <PlaceholderImage label="Portrait" ratio="4/5" icon="user" />
                )
              }
              {c.placeholder && import.meta.env.DEV && <span class="ph-badge">Placeholder</span>}
            </div>
            <div class="pcard-r-body">
              <h3>{c.name}</h3>
              <p class="pcard-r-role">{c.role}</p>
              {c.excerpt && <p class="pcard-r-excerpt">{c.excerpt}</p>}
              <div class="pcard-r-foot">
                {c.serviceTitle && <span class="pcard-r-tag">{c.serviceTitle}</span>}
                <span class="pcard-r-cta">View profile</span>
              </div>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <button type="button" class="pcar-nav pcar-next" aria-label="Show more practitioners" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
  </button>
</div>

<style>
  .pcar { position: relative; }

  /* ---- Track ---- */
  .pcar-track {
    display: flex;
    gap: 24px;
    margin: 0;
    /* Block padding leaves room for the cards' lift and shadow, which would
       otherwise be clipped by the scroll container. */
    padding-block: 8px 20px;
    /* Just the gutter on both sides, so the cards run edge to edge rather than
       starting on the content column's line. The heading above stays in
       `.container`, which is the intended full-bleed contrast. */
    padding-inline: var(--gutter);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Must match the inline padding: without it, snapping the first card's edge
       to the scrollport leaves scrollLeft resting at the padding width instead
       of 0, and the "at the start" test for the arrows never matches. */
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .pcar-track::-webkit-scrollbar { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .pcar-track { scroll-behavior: smooth; }
  }
  .pcar-item {
    flex: 0 0 clamp(232px, 24vw, 286px);
    scroll-snap-align: start;
  }
  /* Mandatory snapping can only rest on a snap point, and the last card's start
     sits past the maximum scroll offset — so without an end-aligned snap point
     here the track stops short and the final card stays half off-screen. */
  .pcar-item:last-child { scroll-snap-align: end; }

  /* ---- Arrows ---- */
  .pcar-nav {
    position: absolute;
    top: calc(50% - 14px);
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: var(--color-surface);
    color: var(--color-brand);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    box-shadow: var(--shadow-md);
    cursor: pointer;
    transition: background var(--transition), color var(--transition), opacity var(--transition);
  }
  /* Both arrows sit against the screen edges the cards run out to. */
  .pcar-prev { left: max(4px, calc(var(--gutter) - 22px)); }
  .pcar-next { right: max(4px, calc(var(--gutter) - 22px)); }
  .pcar-nav:hover { background: var(--color-brand); color: #fff; }
  .pcar-nav:disabled { opacity: 0.32; cursor: default; }
  .pcar-nav:disabled:hover { background: var(--color-surface); color: var(--color-brand); }
  .pcar-nav[hidden] { display: none; }
  .pcar-nav svg {
    width: 17px; height: 17px;
    fill: none; stroke: currentColor; stroke-width: 2;
    stroke-linecap: round; stroke-linejoin: round;
  }

  /* ---- Card ---- */
  .pcard-r {
    /* A fixed height is what makes the reveal work: the body lives below the
       image inside this box, so shrinking the image slides it into view. */
    position: relative;
    display: block;
    height: 400px;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .pcard-r-media {
    position: relative;
    height: 100%;
    overflow: hidden;
    transition: height 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pcard-r-media img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: top;
    /* The source portraits vary a lot in tone; a slight desaturation evens them
       out and full colour comes back on hover. */
    filter: saturate(0.88) contrast(1.02);
    transition: filter 0.4s ease;
  }
  .ph-badge {
    position: absolute; top: 12px; right: 12px;
    font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
    background: rgba(255, 255, 255, 0.92); color: var(--color-text-muted);
    padding: 3px 7px; border-radius: 999px;
  }

  .pcard-r-body {
    display: flex;
    flex-direction: column;
    height: 60%;
    padding: 16px 18px 18px;
  }
  .pcard-r-body h3 { font-size: 1.08rem; line-height: 1.25; margin-bottom: 2px; }
  .pcard-r-role {
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--color-accent);
    text-transform: none;
    margin: 0 0 10px;
  }
  .pcard-r-excerpt {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 14px;
    flex: 1;
    /* Names and roles vary in length, so clamp the blurb rather than let one
       card push its footer out of the box. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pcard-r-foot {
    display: flex; align-items: center; justify-content: space-between;
    gap: 10px; margin-top: auto;
  }
  .pcard-r-tag {
    font-size: 11px; font-weight: 600; color: var(--color-brand);
    background: var(--color-surface-tint);
    border-radius: 999px; padding: 5px 11px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .pcard-r-cta {
    flex-shrink: 0;
    font-size: 12px; font-weight: 600; color: #fff;
    background: var(--color-brand);
    border-radius: 999px; padding: 7px 14px;
  }

  /* ---- The reveal ----
     Only on devices that actually hover. Touch screens get the details shown
     permanently instead, since there is no hover state to discover them with. */
  @media (hover: hover) {
    .pcard-r-media { height: 100%; }
    .pcard-r:hover,
    .pcard-r:focus-visible {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--color-accent);
    }
    .pcard-r:hover .pcard-r-media,
    .pcard-r:focus-visible .pcard-r-media { height: 40%; }
    .pcard-r:hover .pcard-r-media img,
    .pcard-r:focus-visible .pcard-r-media img { filter: saturate(1) contrast(1); }
    .pcard-r:hover h3,
    .pcard-r:focus-visible h3 { color: var(--color-brand); }
  }
  @media (hover: none) {
    .pcard-r-media { height: 40%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pcard-r-media { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-pcar]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-pcar-track]');
    const prev = root.querySelector<HTMLButtonElement>('.pcar-prev');
    const next = root.querySelector<HTMLButtonElement>('.pcar-next');
    if (!track || !prev || !next) return;

    /** One card plus the gap between cards. */
    const step = () => {
      const items = track.querySelectorAll<HTMLElement>('.pcar-item');
      if (items.length < 2) return track.clientWidth;
      return items[1].offsetLeft - items[0].offsetLeft;
    };

    const sync = () => {
      // Nothing to scroll: leave the arrows out of the DOM's tab order entirely.
      const overflows = track.scrollWidth - track.clientWidth > 2;
      prev.hidden = next.hidden = !overflows;
      if (!overflows) return;
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next.addEventListener('click', () => track.scrollBy({ left: step() }));
    track.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  });
</script>
