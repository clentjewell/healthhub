---
/** Interior-page hero: eyebrow + H1 + lede on a tinted band. */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="page-header">
  <div class="narrow">
    {/* data-cms hooks let the CMS live-preview update these as you type. */}
    {eyebrow && <p class="eyebrow" data-cms="eyebrow">{eyebrow}</p>}
    <h1 data-cms="heading">{title}</h1>
    {lede && <p class="lede" data-cms="lede">{lede}</p>}
  </div>
</header>

<style>
  .page-header {
    background: var(--color-surface-tint);
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(48px, 8vw, 88px);
    text-align: center;
  }
  .page-header .lede { margin: 20px auto 0; }
</style>
