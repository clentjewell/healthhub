---
import PlaceholderImage from './PlaceholderImage.astro';
interface Props {
  title: string;
  summary: string;
  href: string;
  icon?: string;
  image?: string;
  placeholder?: boolean;
}
const { title, summary, href, icon, image, placeholder } = Astro.props;
---

<a class="service-card" href={href}>
  <div class="service-media">
    {
      image ? (
        <img src={image} alt={title} loading="lazy" />
      ) : (
        <PlaceholderImage label="Service image" ratio="4/3" icon={icon} />
      )
    }
  </div>
  <div class="service-body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <span class="link">Learn more →</span>
  </div>
  {placeholder && <span class="ph-badge">Placeholder</span>}
</a>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    color: var(--color-text);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .service-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
  }
  .service-media { aspect-ratio: 4/3; overflow: hidden; }
  .service-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .service-card:hover .service-media img { transform: scale(1.04); }
  .service-body { display: flex; flex-direction: column; padding: 24px; flex: 1; }
  .service-card h3 { font-size: 1.2rem; margin-bottom: 10px; }
  .service-card p {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0 0 20px;
    flex: 1;
  }
  .link { font-size: 13px; font-weight: 600; color: var(--color-brand); }
  .ph-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-text-muted);
    padding: 3px 7px;
    border-radius: 999px;
  }
</style>
