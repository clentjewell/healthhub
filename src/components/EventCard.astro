---
import Icon from './Icon.astro';
import { CATEGORY_LABEL } from '../lib/format';

interface Props {
  title: string;
  href: string;
  category: string;
  summary: string;
  schedule?: string;
  image?: string;
  price?: string;
  instructor?: string;
  featured?: boolean;
  /**
   * 'stacked'    — image above text (the 3-up grid on /events)
   * 'horizontal' — text left, image right (homepage teaser)
   */
  layout?: 'stacked' | 'horizontal';
}
const {
  title, href, category, summary, schedule, image, price, instructor, featured,
  layout = 'stacked',
} = Astro.props;
---

<a class:list={['event-card', `is-${layout}`, { featured }]} href={href}>
  <div class="event-media">
    {
      image ? (
        <img src={image} alt={title} loading="lazy" width="940" height="788" />
      ) : (
        <div class="event-media-fallback" aria-hidden="true"><Icon name="calendar" size={32} /></div>
      )
    }
  </div>
  <div class="event-body">
    <p class="event-cat">{CATEGORY_LABEL[category] ?? category}</p>
    <h3>{title}</h3>
    {schedule && (
      <p class="event-when"><Icon name="clock" size={14} /><span>{schedule}</span></p>
    )}
    <p class="event-summary">{summary}</p>
    <p class="event-meta">
      {instructor && <span>{instructor}</span>}
      {price && <span class="event-price">{price}</span>}
    </p>
    <span class="event-link">View details →</span>
  </div>
</a>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    color: var(--color-text);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
  }
  .event-card.featured { border-color: var(--color-accent); }

  /* These are promo graphics with text baked in — show the whole frame. */
  .event-media { background: var(--color-surface-tint); }
  .event-media img {
    width: 100%; height: auto; display: block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .event-card:hover .event-media img { transform: scale(1.03); }
  .event-media-fallback {
    display: flex; align-items: center; justify-content: center;
    aspect-ratio: 940/788; color: var(--color-text-muted);
  }

  .event-body { display: flex; flex-direction: column; flex: 1; padding: 22px 24px 24px; }
  .event-cat {
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-accent); font-weight: 600; margin: 0 0 6px;
  }
  .event-card h3 { font-size: 1.2rem; margin-bottom: 8px; }
  .event-card:hover h3 { color: var(--color-brand); }
  .event-when {
    display: flex; align-items: center; gap: 6px;
    font-size: 13px; font-weight: 600; color: var(--color-text);
    margin: 0 0 10px; font-variant-numeric: tabular-nums;
  }
  .event-summary { font-size: 14px; color: var(--color-text-muted); line-height: 1.55; margin: 0 0 14px; flex: 1; }
  .event-meta {
    display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline;
    font-size: 13px; color: var(--color-text-muted); margin: 0 0 16px;
  }
  .event-price { font-weight: 700; color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .event-link { font-size: 13px; font-weight: 600; color: var(--color-brand); margin-top: auto; }

  /* ---- Horizontal variant: text left, image right ---- */
  .event-card.is-horizontal {
    display: grid;
    grid-template-columns: 1fr 230px;
    align-items: stretch;
  }
  .event-card.is-horizontal .event-body { grid-column: 1; grid-row: 1; }
  .event-card.is-horizontal .event-media {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: center;
    border-left: 1px solid var(--color-border);
  }
  /* The flyers have times and phone numbers baked in, so show them whole
     (letterboxed on the tint) rather than cropping words off. */
  .event-card.is-horizontal .event-media img {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
  }
  @media (max-width: 620px) {
    .event-card.is-horizontal { grid-template-columns: 1fr; }
    .event-card.is-horizontal .event-media {
      grid-column: 1; grid-row: 1;
      border-left: none; border-bottom: 1px solid var(--color-border);
    }
    .event-card.is-horizontal .event-body { grid-row: 2; }
  }
</style>
