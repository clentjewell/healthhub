---
import { formatEventDate, formatEventTime, CATEGORY_LABEL } from '../lib/format';
import Icon from './Icon.astro';
interface Props {
  title: string;
  date: Date;
  category: string;
  summary: string;
  image?: string;
  location?: string;
  price?: string;
  bookingUrl?: string;
  featured?: boolean;
  placeholder?: boolean;
}
const { title, date, category, summary, image, location, price, bookingUrl, featured, placeholder } =
  Astro.props;
---

<article class:list={['event-card', { featured }]}>
  <div class="event-media">
    {image ? <img src={image} alt={title} loading="lazy" width="600" height="450" /> : <div class="event-media-fallback" aria-hidden="true"><Icon name="calendar" size={32} /></div>}
    <span class="event-date">
      <span class="event-day">{formatEventDate(date)}</span>
      <span class="event-time">{formatEventTime(date)}</span>
    </span>
  </div>
  <div class="event-body">
    <p class="event-cat">{CATEGORY_LABEL[category] ?? category}</p>
    <h3>{title}</h3>
    <p class="event-summary">{summary}</p>
    <p class="event-meta">
      {location && <span>{location}</span>}
      {price && <span class="event-price">{price}</span>}
    </p>
    {
      bookingUrl ? (
        <a class="btn btn-primary event-cta" href={bookingUrl}>Book</a>
      ) : (
        <a class="btn btn-ghost event-cta" href="/booking">Enquire</a>
      )
    }
  </div>
  {placeholder && import.meta.env.DEV && <span class="ph-badge">Placeholder</span>}
</article>

<style>
  .event-card {
    position: relative;
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .event-card.featured {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
  .event-media { position: relative; min-height: 180px; background: var(--color-surface-tint); }
  .event-media img { width: 100%; height: 100%; object-fit: cover; }
  .event-media-fallback {
    display: flex; align-items: center; justify-content: center;
    height: 100%; font-size: 2rem; color: var(--color-text-muted);
  }
  .event-date {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: rgba(34, 73, 108, 0.92);
    color: #fff;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
  }
  .event-day { font-family: var(--font-heading); font-size: 0.95rem; text-transform: uppercase; color: #fff; }
  .event-time { font-size: 12px; opacity: 0.9; }
  .event-body { padding: 24px; }
  .event-cat {
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-accent); font-weight: 600; margin: 0 0 6px;
  }
  .event-body h3 { font-size: 1.2rem; margin-bottom: 8px; }
  .event-summary { font-size: 14px; color: var(--color-text-muted); margin: 0 0 12px; }
  .event-meta { display: flex; gap: 16px; font-size: 13px; color: var(--color-text-muted); margin: 0 0 16px; }
  .event-price { font-weight: 600; color: var(--color-text); font-variant-numeric: tabular-nums; }
  .event-cta { padding: 8px 18px; font-size: 13px; min-height: 40px; }
  .event-cta.btn-primary { color: #fff; }
  .event-cta.btn-ghost { color: var(--color-brand); }
  .ph-badge {
    position: absolute; top: 12px; right: 12px;
    font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
    background: rgba(255, 255, 255, 0.92); color: var(--color-text-muted);
    padding: 3px 7px; border-radius: 999px;
  }
  @media (max-width: 620px) {
    .event-card { grid-template-columns: 1fr; }
    .event-media { min-height: 160px; }
  }
</style>
