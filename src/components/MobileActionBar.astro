---
/**
 * Sticky Book / Call bar shown ONLY on mobile, so the two key actions are
 * always one tap away without scrolling to the footer or opening the menu.
 * Desktop is unchanged (the header keeps its "Make a Booking" button).
 */
interface Props {
  phone?: string;
  bookingHref: string;
  bookingLabel?: string;
}
const { phone, bookingHref, bookingLabel = 'Book' } = Astro.props;
const tel = phone ? `tel:${phone.replace(/\s/g, '')}` : null;
---

<div class="mab" role="navigation" aria-label="Quick actions">
  {tel && (
    <a class="mab-btn mab-call" href={tel} aria-label={`Call ${phone}`}>
      <span aria-hidden="true">📞</span> Call
    </a>
  )}
  <a class="mab-btn mab-book" href={bookingHref}>{bookingLabel}</a>
</div>

<style>
  /* Hidden on desktop; only appears on small screens. */
  .mab {
    display: none;
  }
  @media (max-width: 768px) {
    .mab {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 60;
      display: flex;
      gap: 8px;
      padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
      background: var(--color-surface, #fff);
      border-top: 1px solid var(--color-border, #dce6eb);
      box-shadow: 0 -3px 14px rgba(0, 0, 0, 0.1);
    }
    .mab-btn {
      flex: 1;
      text-align: center;
      padding: 13px 10px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 1rem;
      text-decoration: none;
      line-height: 1;
    }
    .mab-call {
      color: var(--color-brand, #34719f);
      border: 1.5px solid var(--color-brand, #34719f);
      background: var(--color-surface, #fff);
    }
    .mab-book {
      background: var(--color-brand, #34719f);
      color: #fff;
    }
    /* Keep the fixed bar from covering the last of the footer. */
    :global(body) {
      padding-bottom: 74px;
    }
  }
</style>
