---
/**
 * Inline SVG icons — one family, consistent 1.5px stroke on a 24px grid.
 *
 * Replaces emoji, which render differently per platform/font and can't be
 * themed. Decorative by default (aria-hidden); pass a `label` when the icon
 * carries meaning on its own.
 */
interface Props {
  name: 'user' | 'calendar' | 'map-pin' | 'image' | 'clock' | 'facebook' | 'instagram' | 'globe';
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
