---
/**
 * Styled placeholder box for images not yet migrated (Phase 3).
 * Uses the brand tint so layouts read correctly before real imagery lands.
 */
import Icon from './Icon.astro';

interface Props {
  label?: string;
  ratio?: string; // e.g. "4/3", "4/5", "16/9"
  /** Icon name from Icon.astro — never an emoji. */
  icon?: 'user' | 'calendar' | 'map-pin' | 'image' | 'clock';
}
const { label = 'Image', ratio = '4/3', icon = 'image' } = Astro.props;
---

<div class="ph" style={`aspect-ratio:${ratio}`}>
  <Icon name={icon} size={30} class="ph-icon" />
  <span class="ph-label">{label}</span>
</div>

<style>
  .ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: var(--color-surface-tint);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    text-align: center;
    padding: 16px;
    overflow: hidden;
  }
  .ph-icon { opacity: 0.5; }
  .ph-label {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
