# HTTP response headers for the Cloudflare Workers static-assets deployment.
# Same mechanism as public/_redirects.
#
# ONE Content-Security-Policy only. Cloudflare's _headers is additive — two
# blocks would send two CSP headers and browsers enforce their intersection, so
# everything the site needs lives in this single site-wide policy.
#
# The contact form posts to the site's own /contact.php now (no FormSubmit), and
# the CMS runs on its own worker (the old Sveltia bundle from unpkg is gone), so
# the site itself only needs 'self' plus Google Maps (embed). frame-ancestors
# still allows the CMS worker to iframe the site for the editor's live preview.
#
# Kept in sync with public/.htaccess (the cPanel/Apache equivalent).
#
# NOT set here on purpose: Strict-Transport-Security (HSTS). Enable that on the
# real domain at cutover (Cloudflare dashboard → SSL/TLS → Edge Certificates →
# HSTS), not on the shared *.workers.dev host.

/*
  X-Content-Type-Options: nosniff
  # No X-Frame-Options: it can't express an allow-list. Framing is controlled by
  # the CSP frame-ancestors below, which permits only the site and the CMS
  # (for the content editor's live preview).
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-src https://maps.google.com https://www.google.com; connect-src 'self'; form-action 'self'; frame-ancestors 'self' https://healthhub-cms-auth.clent.workers.dev; base-uri 'self'; object-src 'none'
