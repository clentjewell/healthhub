# .htaccess — redirects for cPanel / Apache hosting.
#
# This mirrors public/_redirects (the Cloudflare Workers format). Apache reads
# this file; Cloudflare ignores it, and vice-versa, so both can sit in the repo
# safely. If you add a redirect in one, add the matching rule in the other.
#
# RedirectMatch (mod_alias, on by default on cPanel) is used with anchored
# patterns so each rule matches that one path only — with or without a trailing
# slash — and never a path that merely starts with it. 301 = permanent (keeps
# search ranking); 302 = temporary.

# The content editor (CMS) lives on its own Cloudflare Worker.
RedirectMatch 302 ^/admin/?$ https://healthhub-cms-auth.clent.workers.dev/

# Shannon O'Hara left the Hub and Kate Doedee took over her classes, so send
# her old profile link straight to Kate's profile.
RedirectMatch 301 ^/our-practitioner/shannon-ohara/?$ /our-practitioner/kate-doedee/

# The ADHD Workshop page was removed before its details were confirmed; the
# workshop still shows on the timetable, so send old links there.
RedirectMatch 301 ^/event/adhd-workshop/?$ /event/health-hub-studio-time-table/

# Mis-slugged on WordPress — this was always Katie Verkerk's Function & Flow class.
RedirectMatch 301 ^/event/naturopathic-health-seminars-with-katie-verkerk/?$ /event/function-flow/

# Seniors Yoga was folded into Alicia Grace's Yoga & Meditation page (her single
# class page), so its standalone page was retired.
RedirectMatch 301 ^/event/seniors-yoga/?$ /event/yoga-meditation/


# ── Security response headers ────────────────────────────────────────────────
# The Apache equivalent of public/_headers (Cloudflare). Keep the two in sync.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # No X-Frame-Options: it can't express an allow-list. Framing is controlled by
  # the CSP frame-ancestors below, which permits only the site and the CMS
  # worker (for the content editor's live preview).
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-src https://maps.google.com https://www.google.com; connect-src 'self' https://formsubmit.co; form-action 'self' https://formsubmit.co; frame-ancestors 'self' https://healthhub-cms-auth.clent.workers.dev; base-uri 'self'; object-src 'none'"

  # HSTS — turn on ONLY once HTTPS is confirmed working on the live domain, as
  # it forces HTTPS for the max-age. Uncomment then, and consider preloading.
  # Header always set Strict-Transport-Security "max-age=15768000; includeSubDomains"
</IfModule>

# ── Static-site niceties for Apache ──────────────────────────────────────────
# Serve pretty 404s (Astro builds /404.html).
ErrorDocument 404 /404.html

# Long-cache ONLY the fingerprinted build assets (their filenames change when
# the content does). Images and fonts are deliberately left to Apache defaults
# so a photo swapped in the CMS (same filename) isn't stuck in cache.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
